// =========================================
// SELLER MODEL (Продавец)
// =========================================

model Seller {
  id        String   @id @default(cuid())
  
  // === Основные данные ===
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  middleName String?  @map("middle_name")
  phone      String
  email      String?
  iin        String?  @unique
  city       String?
  source     String?  // Источник контакта (Instagram, WhatsApp, Referral)
  
  // === 1️⃣ Причина продажи и сроки ===
  reason           SaleReason?
  reasonOther      String?          @map("reason_other")
  deadline         SaleDeadline?
  
  // === 2️⃣ Ценовые ожидания ===
  expectedPrice    Decimal?         @map("expected_price") @db.Decimal(15, 2)
  minPrice         Decimal?         @map("min_price") @db.Decimal(15, 2)
  marketAssessment MarketAssessment? @map("market_assessment")
  readyToNegotiate Boolean          @default(true) @map("ready_to_negotiate")
  
  // === 3️⃣ Планы после продажи ===
  plansToPurchase    Boolean        @default(false) @map("plans_to_purchase")
  plansMortgage      Boolean        @default(false) @map("plans_mortgage")
  nextPurchaseFormat String?        @map("next_purchase_format")
  purchaseBudget     Decimal?       @map("purchase_budget") @db.Decimal(15, 2)
  
  // === 4️⃣ Финансовые возможности ===
  incomeSource     String?          @map("income_source")
  incomeAmount     Decimal?         @map("income_amount") @db.Decimal(15, 2)
  hasDebts         Boolean          @default(false) @map("has_debts")
  loanPaymentAmount Decimal?        @map("loan_payment_amount") @db.Decimal(15, 2)
  
  // === 5️⃣ Готовность работать с Casa ===
  readyToFollowRecommendations ReadyToFollow? @map("ready_to_follow")
  readyForExclusive Boolean        @default(false) @map("ready_for_exclusive")
  trustLevel        Int            @default(3) @map("trust_level")
  
  // === 6️⃣ Комментарии ===
  managerComment   String?          @map("manager_comment") @db.Text
  
  // === 7️⃣ Коммуникация ===
  communicationChannel String?      @map("communication_channel") // Звонок, WhatsApp, Telegram
  preferredTime        String?      @map("preferred_time")        // Удобное время для связи
  
  // === Воронка продавца ===
  funnelStage      SellerFunnelStage @default(CONTACT) @map("funnel_stage")
  strategyConfirmed Boolean         @default(false) @map("strategy_confirmed")
  cancellationReason CancellationReason? @map("cancellation_reason")
  cancellationComment String?       @map("cancellation_comment") @db.Text
  
  // === Метаданные ===
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  brokerId   String   @map("broker_id")
  // Аккаунт собственника (роль OWNER), если продавец завёл себя сам.
  // У продавцов, созданных координатором из CRM, ссылки нет.
  userId     String?  @unique @map("user_id")

  // === Relations ===
  broker     User          @relation("BrokerSellers", fields: [brokerId], references: [id])
  ownerAccount User?       @relation("OwnerSellerProfile", fields: [userId], references: [id])
  properties CrmProperty[]
  listingAgreements ListingAgreement[]
  documents  SellerDocument[]
  customStageId String? @map("custom_stage_id")
  customStage   CustomStage? @relation(fields: [customStageId], references: [id])
  projectId      String?       @map("project_id")
  project        Project?      @relation(fields: [projectId], references: [id])
  apartmentId    String?       @map("apartment_id")
  apartment      Apartment?    @relation(fields: [apartmentId], references: [id])
  customFieldValues CustomFieldValue[]
  
  @@index([brokerId])
  @@index([funnelStage])
  @@index([phone])
  @@map("sellers")
}

model SellerDocument {
  id         String   @id @default(cuid())
  name       String
  type       String
  fileUrl    String   @map("file_url")
  fileSize   Int      @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  sellerId   String   @map("seller_id")
  
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  @@index([sellerId])
  @@map("seller_documents")
}

model Buyer {
  id        String   @id @default(cuid())
  firstName String   @map("first_name")
  lastName  String?  @map("last_name")
  phone     String
  minBudget Decimal? @map("min_budget") @db.Decimal(15, 2)
  maxBudget Decimal? @map("max_budget") @db.Decimal(15, 2)
  status    BuyerStatus @default(NEW)
  preferences Json?
  notes     String?  @db.Text
  
  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")
  brokerId  String   @map("broker_id")
  
  // Relations
  broker User    @relation("BrokerBuyers", fields: [brokerId], references: [id])
  shows  Show[]
  offers Offer[] // New
  propertyInterests ClientPropertyInterest[]
  secondaryDeals    SecondaryDeal[]
  secondaryFixations SecondaryFixation[]

  @@index([brokerId])
  @@index([status])
  @@map("crm_buyers")
}

// Show = каноническая сущность "Viewing" из CASA Developer Handoff v2.0
// (03_CASA_Showings_Spec). Поля ниже расширяют модель до канонического
// стейт-машина (см. ShowStatus) аддитивно — старые поля (date/status
// SCHEDULED|COMPLETED|CANCELLED) оставлены как есть, чтобы не сломать живые
// маршруты buyers.routes.ts; новые поля nullable до отдельного шага, где
// эти маршруты переведут на канонический guard (см. showing.service.ts).
model Show {
  id         String   @id @default(cuid())
  date       DateTime
  status     ShowStatus @default(SCHEDULED)
  feedback   String?  @db.Text
  feedbackSentiment FeedbackSentiment? @map("feedback_sentiment")
  rating     Int?     // 1-5 Оценка клиента объекту

  // === Канонические поля Viewing (03_CASA_Showings_Spec, раздел 5) ===
  showingManagerId    String?   @map("showing_manager_id")
  proposedStartAt     DateTime? @map("proposed_start_at")
  proposedEndAt       DateTime? @map("proposed_end_at")
  confirmedStartAt    DateTime? @map("confirmed_start_at")
  confirmedEndAt      DateTime? @map("confirmed_end_at")
  timezone            String?   @default("Asia/Almaty")
  confirmationSource  String?   @map("confirmation_source") // in_app | phone | whatsapp | sms | other
  confirmedBy         String?   @map("confirmed_by")
  confirmedAt         DateTime? @map("confirmed_at")
  cancellationReason  String?   @map("cancellation_reason") @db.Text
  meetingInstructionsSafe String? @map("meeting_instructions_safe") @db.Text
  accessMode          String?   @map("access_mode")
  internalAccessNote  String?   @map("internal_access_note") @db.Text
  attendanceStatus    String?   @map("attendance_status")
  completedAt         DateTime? @map("completed_at")
  feedbackStatus      String?   @map("feedback_status")
  nextStep            String?   @map("next_step")
  version             Int       @default(1)
  createdBy           String?   @map("created_by")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  propertyId String   @map("property_id")
  buyerId    String   @map("buyer_id")

  // Relations
  property CrmProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer    Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([buyerId])
  @@map("crm_shows")
}

model Offer {
  id         String   @id @default(cuid())
  price      Decimal  @db.Decimal(15, 2)
  status     OfferStatus @default(PENDING)
  comment    String?  @db.Text
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  propertyId String   @map("property_id")
  buyerId    String   @map("buyer_id")
  
  // Relations
  property CrmProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer    Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  secondaryDeal SecondaryDeal?

  @@index([propertyId])
  @@index([buyerId])
  @@map("crm_offers")
}

enum BuyerStatus {
  NEW         // Новый
  ACTIVE      // Активный (THINKING replaced)
  OFFER_MADE  // Сделал предложение
  ARCHIVED    // Архив
  REFUSAL     // Отказ (Legacy? Keeping it)
}

enum ShowStatus {
   SCHEDULED // legacy — сохранён для обратной совместимости живых маршрутов
   COMPLETED
   CANCELLED
   // === Канонические статусы Viewing из 03_CASA_Showings_Spec ===
   DRAFT
   REQUESTED
   AWAITING_SELLER_CONFIRMATION
   CONFIRMED
   RESCHEDULE_REQUESTED
   NO_SHOW_BUYER
   NO_SHOW_SELLER
   EXPIRED
}

enum FeedbackSentiment {
   POSITIVE
   NEUTRAL
   NEGATIVE
}

enum OfferStatus {
   PENDING
   ACCEPTED
   REJECTED
}

// =========================================
// CRM PROPERTY MODEL (Объект недвижимости)
// =========================================

model CrmProperty {
  id          String   @id @default(cuid())
  
  // === 1️⃣ Идентификация объекта ===
  propertyType        String   @default("APARTMENT") @map("property_type")
  rooms               Int
  residentialComplex  String   @map("residential_complex")
  district            String
  address             String?
  lat                 Float?
  lng                 Float?
  customStageId String? @map("custom_stage_id")
  customStage   CustomStage? @relation(fields: [customStageId], references: [id])
  
  // === 2️⃣ Геометрия и базовые параметры ===
  area               Decimal   @db.Decimal(10, 2)
  livingArea         Decimal?  @map("living_area") @db.Decimal(10, 2)
  kitchenArea        Decimal?  @map("kitchen_area") @db.Decimal(10, 2)
  floor              Int
  totalFloors        Int       @map("total_floors")
  yearBuilt          Int       @map("year_built")
  apartmentsPerFloor Int?      @map("apartments_per_floor")
  
  // === 3️⃣ Конструктив и планировка ===
  buildingType       BuildingType   @default(PANEL) @map("building_type")
  ceilingHeight      Decimal?       @map("ceiling_height") @db.Decimal(3, 2)
  layoutType         LayoutType     @default(ISOLATED) @map("layout_type")
  bathroomType       String?        @map("bathroom_type")
  balconyType        String?        @map("balcony_type")
  
  // === 4️⃣ Локация и окружение ===
  locationQuality    LocationQuality @default(NORMAL) @map("location_quality")
  viewType           ViewType?       @map("view_type")
  
  // === 5️⃣ Паркинг ===
  parkingType        ParkingType    @default(NONE) @map("parking_type")
  parkingSpaces      Int            @default(0) @map("parking_spaces")
  
  // === 6️⃣ Состояние квартиры ===
  repairState        RepairState    @default(COSMETIC) @map("repair_state")
  actualCondition    ActualCondition @default(GOOD) @map("actual_condition")
  
  // === 7️⃣ Дом и МОП ===
  elevatorCount      Int            @default(0) @map("elevator_count")
  hasFreightElevator Boolean        @default(false) @map("has_freight_elevator")
  lobbyType          LobbyType?     @map("lobby_type")
  accessSystem       AccessSystemType? @map("access_system")
  mopState           MopState?      @map("mop_state")
  hasClosedTerritory Boolean        @default(false) @map("has_closed_territory")
  lastCapitalRepairYear Int?        @map("last_capital_repair_year")
  
  // === 8️⃣ Финансовый и юридический статус ===
  isMortgaged           Boolean     @default(false) @map("is_mortgaged")
  mortgageBank          String?     @map("mortgage_bank")
  mortgageRemaining     Decimal?    @map("mortgage_remaining") @db.Decimal(15, 2)
  mortgageRemovalMethod String?     @map("mortgage_removal_method")
  encumbranceType       EncumbranceType @default(NONE) @map("encumbrance_type")
  encumbranceDescription String?    @map("encumbrance_description") @db.Text
  documentsVerified     Boolean     @default(false) @map("documents_verified")
  
  // === 9️⃣ УТП и комплектация ===
  hasFloorHeating       Boolean     @default(false) @map("has_floor_heating")
  hasWalkInCloset       Boolean     @default(false) @map("has_walk_in_closet")
  hasAirConditioning    Boolean     @default(false) @map("has_air_conditioning")
  hasBuiltInAppliances  Boolean     @default(false) @map("has_built_in_appliances")
  hasPanoramicWindows   Boolean     @default(false) @map("has_panoramic_windows") // New
  furnitureLevel        String?     @map("furniture_level")
  appliancesLevel       String?     @map("appliances_level")
  
  // === Бизнес-класс специфичные ===
  glazingType           GlazingType? @map("glazing_type")
  facadeMaterial        String?      @map("facade_material")
  
  // === Ценообразование ===
  price                 Decimal      @db.Decimal(15, 2)
  pricePerSqm           Decimal?     @map("price_per_sqm") @db.Decimal(15, 2)
  marketPrice           Decimal?     @map("market_price") @db.Decimal(15, 2)
  
  // === АВТО-ВЫЧИСЛЯЕМЫЕ ПОЛЯ ===
  calculatedClass       PropertyClass?  @map("calculated_class")
  financeType           FinanceType     @default(MORTGAGE_AVAILABLE) @map("finance_type")
  liquidityScore        Int             @default(50) @map("liquidity_score")
  liquidityLevel        LiquidityLevel? @map("liquidity_level")
  isIlliquid            Boolean         @default(false) @map("is_illiquid")
  illiquidReason        String?         @map("illiquid_reason")
  activeStrategy        StrategyType?   @map("active_strategy")
  recommendedStrategy   StrategyType?   @map("recommended_strategy") // Рассчитанная системой
  isStrategyManual      Boolean         @default(false) @map("is_strategy_manual") // Брокер изменил вручную
  strategyExplanation   String?         @map("strategy_explanation") @db.Text
  
  // === Воронка объекта ===
  funnelStage           PropertyFunnelStage @default(CREATED) @map("funnel_stage")
  cancellationReason    CancellationReason? @map("cancellation_reason")
  cancellationComment   String?             @map("cancellation_comment") @db.Text
  
  // === Статистика ===
  viewsCount            Int         @default(0) @map("views_count")
  showsCount            Int         @default(0) @map("shows_count")
  leadsCount            Int         @default(0) @map("leads_count")
  
  // === Медиа ===
  images                String[]    @default([])
  documents             String[]    @default([]) // New: URLs to PDFs, Docs
  videoUrl              String?     @map("video_url")
  virtualTourUrl        String?     @map("virtual_tour_url")
  layoutImage           String?     @map("layout_image")
  
  // === Публикации ===
  casaUrl               String?     @map("casa_url")
  krishaUrl             String?     @map("krisha_url")
  knUrl                 String?     @map("kn_url")
  olxUrl                String?     @map("olx_url")
  instagramUrl          String?     @map("instagram_url")
  tikTokUrl             String?     @map("tiktok_url") // New
  
  // === Мета ===
  notes                 String?     @db.Text
  description            String?     @db.Text
  negotiable             Boolean     @default(false) // "торг" — публичная карточка casa40
  readyToMoveIn          Boolean     @default(true) @map("ready_to_move_in")
  status                PropertyStatus @default(ACTIVE)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  publishedAt           DateTime?   @map("published_at")
  
  // === Связи ===
  sellerId              String      @map("seller_id")
  brokerId              String      @map("broker_id")
  
  seller                Seller      @relation(fields: [sellerId], references: [id])
  broker                User        @relation("BrokerCrmProperties", fields: [brokerId], references: [id])
  calculationLogs       PropertyCalculationLog[]
  shows                 Show[]
  offers                Offer[]
  customFieldValues     CustomFieldValue[]
  events                Event[]
  viewingRequests       ViewingRequest[]
  valuations            Valuation[]
  clientLinks           ClientPropertyLink[]
  secondaryDeals        SecondaryDeal[]
  selectionEntries      SelectionCrmProperty[]
  propertyInterests     ClientPropertyInterest[]
  publicListingOps      PublicListingOps?
  publicListingLeads    PublicListingLead[]
  listingAgreements     ListingAgreement[]
  secondaryFixations    SecondaryFixation[]
  listingExits          ListingExit[]

  // Кто завёл объект. OWNER_SELF — собственник через свой кабинет,
  // COORDINATOR — сотрудник CASA от его имени, LEGACY — записи, созданные
  // до появления контура вторички.
  listingSource         ListingSource @default(LEGACY) @map("listing_source")

  aiRecommendation      String?         @map("ai_recommendation") @db.Text

  @@index([sellerId])
  @@index([brokerId])
  @@index([funnelStage])
  @@index([calculatedClass])
  @@index([liquidityLevel])
  @@index([activeStrategy])
  @@index([district])
  @@index([status])
  // Матчит точный where+orderBy публичного каталога (public-properties.routes.ts) —
  // без него это unauthenticated-запрос на full scan по мере роста таблицы
  @@index([status, funnelStage, publishedAt])
  @@map("crm_properties")
}

// Лог расчётов (для аудита изменений класса/ликвидности/стратегии)
model PropertyCalculationLog {
  id            String   @id @default(cuid())
  propertyId    String   @map("property_id")
  
  previousClass     PropertyClass?   @map("previous_class")
  newClass          PropertyClass?   @map("new_class")
  previousLiquidity Int?             @map("previous_liquidity")
  newLiquidity      Int?             @map("new_liquidity")
  previousStrategy  StrategyType?    @map("previous_strategy")
  newStrategy       StrategyType?    @map("new_strategy")
  
  calculationReason String           @map("calculation_reason")
  inputData         Json             @map("input_data")
  outputData        Json             @map("output_data")
  
  createdAt         DateTime         @default(now()) @map("created_at")
  
  property          CrmProperty      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@index([propertyId])
  @@index([createdAt])
  @@map("property_calculation_logs")
}

model SystemSettings {
  key         String   @id
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// =========================================
// AUDIT LOG (CASA Developer Handoff v2.0 — Foundation)
// Append-only для обычных ролей: удаление и правка старых записей
// запрещены на уровне приложения (нет DELETE/UPDATE роута), не БД.
// =========================================

model AuditLog {
  id              String   @id @default(cuid())
  actorUserId     String?  @map("actor_user_id")
  actorRole       String?  @map("actor_role")
  // HUMAN | AI — AI-действия обязаны маркироваться отдельно и не могут
  // менять критические статусы (Green, deposit, booking, notary, sold/failed).
  actorType       String   @default("HUMAN") @map("actor_type")
  aiModel         String?  @map("ai_model")
  aiPromptVersion String?  @map("ai_prompt_version")
  action          String
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  requestId       String?  @map("request_id")
  source          String?  // api | system | import | ai
  oldValues       Json?    @map("old_values")
  newValues       Json?    @map("new_values")
  reason          String?  @db.Text
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Версионируемые справочники/коэффициенты (валюационные модификаторы,
// ипотечные пороги, комиссионные тарифы) — CASA Developer Handoff v2.0
// требует, чтобы эти значения не были зашиты в код и хранили историю.
// Значение считается активным на дату, если effective_from <= now
// и (effective_to IS NULL OR effective_to > now).
model ConfigVersion {
  id            String    @id @default(cuid())
  key           String // "valuation.modifiers.almaty", "mortgage.otbasy.thresholds", ...
  scope         String? // доп. разрез: city_id, bank_id и т.п., свободный текст
  value         Json
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")
  reason        String?   @db.Text
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  creator User? @relation(fields: [createdBy], references: [id])

  @@index([key, effectiveFrom])
  @@index([key, isActive])
  @@map("config_versions")
}

// Единая точка ссылки на файлы в закрытом хранилище — CASA Developer
// Handoff v2.0 запрещает публичные бессрочные URL для критичных файлов
// (документы сделки, подтверждающие фото/сканы). PropertyMedia/DealDocument
// и т.п. ссылаются сюда вместо хранения url-строки напрямую.
// NB: существующие маршруты загрузки (uploads.routes.ts, public-uploads.routes.ts)
// пока не переведены на FileAsset — это отдельная, более рискованная миграция
// (нужно не сломать уже открытые в проде публичные URL), см. gap-audit.
model FileAsset {
  id           String   @id @default(cuid())
  bucket       String
  objectKey    String   @map("object_key")
  originalName String?  @map("original_name")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  checksum     String?
  // Тип и ID сущности-владельца (property_media, deal_document, client_document...)
  ownerType    String?  @map("owner_type")
  ownerId      String?  @map("owner_id")
  uploadedBy   String?  @map("uploaded_by")
  isPublic     Boolean  @default(false) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")

  uploader User? @relation(fields: [uploadedBy], references: [id])

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
  @@map("file_assets")
}

// =========================================
// CUSTOM CRM (Phase 2)
// =========================================

model CustomFunnel {
  id        String   @id @default(cuid())
  name      String
  userId    String   @map("user_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages    CustomStage[]
  customFields CustomField[]

  @@map("custom_funnels")
}

model CustomStage {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#3B82F6") // Blue default
  order     Int
  funnelId  String   @map("funnel_id")

  funnel    CustomFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  sellers        Seller[]
  crmProperties  CrmProperty[]

  @@index([funnelId])
  @@map("custom_stages")
}

model CustomField {
  id        String   @id @default(cuid())
  name      String
  type      CustomFieldType
  entityType CustomFieldEntity
  
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  funnelId  String?  @map("funnel_id") // Optional: limit field to specific funnel
  funnel    CustomFunnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  options   String[] @default([]) // For SELECT/CHECKBOX
  isActive  Boolean  @default(true) @map("is_active")

  values    CustomFieldValue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("custom_fields")
}

model CustomFieldValue {
  id        String   @id @default(cuid())
  fieldId   String   @map("field_id")
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  sellerId    String? @map("seller_id")
  seller      Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  propertyId  String? @map("property_id")
  property    CrmProperty? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  value       String  @db.Text // Store as string (JSON if needed)

  @@unique([fieldId, sellerId])
  @@unique([fieldId, propertyId])
  @@index([sellerId])
  @@index([propertyId])
  @@map("custom_field_values")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
  TEXTAREA
}

enum CustomFieldEntity {
  SELLER
  PROPERTY
}

model ViewingRequest {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  name       String
  phone      String
  createdAt  DateTime @default(now()) @map("created_at")

  property   CrmProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("viewing_requests")
}

// =========================================
// VALUATION (CASA Developer Handoff v2.0 — Valuation module)
// Путь: submitted → preliminary_calculation → preliminary_ready |
// manual_review_required → comparable_collection → human_review →
// confirmed → accepted | accepted_with_price_condition | rejected.
// Hard guard из 02_CASA_Valuation_Spec: предварительная оценка ≠ принятие
// объекта; confirmed-версия неизменяема (isImmutable) после подтверждения.
// =========================================

enum ValuationStatus {
  SUBMITTED
  PRELIMINARY_CALCULATION
  PRELIMINARY_READY
  MANUAL_REVIEW_REQUIRED
  COMPARABLE_COLLECTION
  HUMAN_REVIEW
  CONFIRMED
  ACCEPTED
  ACCEPTED_WITH_PRICE_CONDITION
  REJECTED
}

enum ValuationLiquidity {
  LOW
  MEDIUM
  HIGH
}

enum ValuationConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ValuationDecision {
  ACCEPTED
  ACCEPTED_WITH_PRICE_CONDITION
  REJECTED
}

enum ComparableCompatibility {
  DIRECT          // Прямой аналог (тот же ЖК/адрес)
  CLOSE           // Близкий аналог (тот же район/класс)
  MARKET_CONTEXT  // Только городская аналитика — не заменяет прямые аналоги
}

model Valuation {
  id             String          @id @default(cuid())
  propertyId     String          @map("property_id")
  status         ValuationStatus @default(SUBMITTED)
  currentVersion Int             @default(0) @map("current_version")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  property CrmProperty        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  versions ValuationVersion[]

  @@index([propertyId])
  @@index([status])
  @@map("valuations")
}

// Каждое подтверждение/пересчёт создаёт новую версию, а не правит старую —
// confirmed-версия immutable (раздел 9 acceptance criteria спеки).
model ValuationVersion {
  id            String @id @default(cuid())
  valuationId   String @map("valuation_id")
  versionNumber Int    @map("version_number")

  preliminaryLow  Decimal? @map("preliminary_low") @db.Decimal(15, 2)
  preliminaryHigh Decimal? @map("preliminary_high") @db.Decimal(15, 2)

  confirmedLow           Decimal? @map("confirmed_low") @db.Decimal(15, 2)
  confirmedHigh          Decimal? @map("confirmed_high") @db.Decimal(15, 2)
  urgentLow              Decimal? @map("urgent_low") @db.Decimal(15, 2)
  urgentHigh             Decimal? @map("urgent_high") @db.Decimal(15, 2)
  recommendedLaunchPrice Decimal? @map("recommended_launch_price") @db.Decimal(15, 2)
  maxLaunchPrice         Decimal? @map("max_launch_price") @db.Decimal(15, 2)

  liquidity      ValuationLiquidity?
  confidence     ValuationConfidence?
  decision       ValuationDecision?
  reviewerReason String?              @map("reviewer_reason") @db.Text
  reviewerId     String?              @map("reviewer_id")
  reviewedAt     DateTime?            @map("reviewed_at")

  // true только после confirm — дальше версия не редактируется, только
  // создаётся новая (раздел "Acceptance criteria": изменение аналогов или
  // модификаторов создаёт новую версию результата).
  isImmutable Boolean @default(false) @map("is_immutable")

  marketReferenceId String? @map("market_reference_id")

  createdAt DateTime @default(now()) @map("created_at")

  valuation       Valuation        @relation(fields: [valuationId], references: [id], onDelete: Cascade)
  reviewer        User?            @relation(fields: [reviewerId], references: [id])
  marketReference MarketReference? @relation(fields: [marketReferenceId], references: [id])
  comparables     Comparable[]

  @@unique([valuationId, versionNumber])
  @@index([valuationId])
  @@map("valuation_versions")
}

model Comparable {
  id                 String                  @id @default(cuid())
  valuationVersionId String                  @map("valuation_version_id")
  sourceRef          String                  @map("source_ref")
  checkedAt          DateTime                @map("checked_at")
  askingPrice        Decimal                 @map("asking_price") @db.Decimal(15, 2)
  totalArea          Decimal                 @map("total_area") @db.Decimal(10, 2)
  pricePerM2         Decimal?                @map("price_per_m2") @db.Decimal(15, 2)
  compatibility      ComparableCompatibility
  included           Boolean                 @default(true)
  reasonExcluded      String?                @map("reason_excluded") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  valuationVersion ValuationVersion @relation(fields: [valuationVersionId], references: [id], onDelete: Cascade)

  // Уникально valuation_version_id + normalized_source_ref (раздел 4 спеки);
  // нормализация (trim/lowercase) — на уровне сервиса перед записью.
  @@unique([valuationVersionId, sourceRef])
  @@index([valuationVersionId])
  @@map("comparables")
}

// Базовый рыночный ориентир (город → ЖК/адрес → комнаты → ремонт, fallback —
// район) для предварительного расчёта. Отдельно от ConfigVersion: это сырые
// рыночные данные с датой проверки и сроком годности, а не коэффициент.
model MarketReference {
  id                   String   @id @default(cuid())
  cityId               String   @map("city_id")
  districtId           String?  @map("district_id")
  residentialComplexId String?  @map("residential_complex_id")
  rooms                Int?
  renovationState      String?  @map("renovation_state")
  basePricePerM2Low    Decimal  @map("base_price_per_m2_low") @db.Decimal(15, 2)
  basePricePerM2High   Decimal  @map("base_price_per_m2_high") @db.Decimal(15, 2)
  sourceDate           DateTime @map("source_date")
  validUntil           DateTime? @map("valid_until")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")

  valuationVersions ValuationVersion[]

  @@index([cityId, residentialComplexId, rooms])
  @@index([cityId, districtId])
  @@map("market_references")
}

// =========================================
// CLIENT PROPERTY INTEREST (CASA Developer Handoff v2.0 — Showings module)
// Промежуточный шаг между лидом/подборкой и запросом показа (03_CASA_
// Showings_Spec, канонический путь: ClientPropertyInterest → viewing draft
// → ... ). Отдельная сущность от Show/Viewing — фиксирует сам факт интереса
// до того, как показ реально запрошен/назначен.
// NB: не связана FK с Show в этом проходе — полноценная перестройка
// Show.propertyId/buyerId на ссылку через ClientPropertyInterest отложена
// как отдельная, более рискованная миграция (см. gap-audit).
// =========================================

enum ClientPropertyInterestStatus {
  ACTIVE
  CLOSED
}

model ClientPropertyInterest {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  buyerId    String   @map("buyer_id")
  brokerId   String   @map("broker_id")
  status     ClientPropertyInterestStatus @default(ACTIVE)
  note       String?  @db.Text
  closedAt   DateTime? @map("closed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property CrmProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer    Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  broker   User        @relation(fields: [brokerId], references: [id])

  @@index([propertyId])
  @@index([buyerId])
  @@index([brokerId])
  @@map("client_property_interests")
}

// =========================================
// SECONDARY DEAL / DEAL ROOM (CASA Developer Handoff v2.0, 04_CASA_Deal_Room_Spec)
// НЕ путать с существующей моделью Deal — та обслуживает живую фичу
// брокерского Kanban + ИИ-агента (DealAgentAction, коммит 02e51ea) и
// работает по совсем другим бизнес-правилам. SecondaryDeal — отдельный
// контур строго для вторички, открывается первым формальным офером и не
// принимает задаток (CASA не принимает деньги, раздел 1 спеки).
//
// Канонический путь: offer_submitted → seller_review → counteroffer_sent |
// price_agreed → precheck_in_progress → yellow_blocked | green_1 → green_2 →
// deposit_agreement_drafting → deposit_agreement_sent → deposit_agreement_signed
// → deposit_transfer_pending → booking_active → payment_route_in_progress →
// ready_for_notary → notary_scheduled → registration_or_disbursement →
// sold | failed.
// =========================================

enum DealRoomStage {
  OFFER_SUBMITTED
  SELLER_REVIEW
  COUNTEROFFER_SENT
  PRICE_AGREED
  PRECHECK_IN_PROGRESS
  YELLOW_BLOCKED
  GREEN_1
  GREEN_2
  DEPOSIT_AGREEMENT_DRAFTING
  DEPOSIT_AGREEMENT_SENT
  DEPOSIT_AGREEMENT_SIGNED
  DEPOSIT_TRANSFER_PENDING
  BOOKING_ACTIVE
  PAYMENT_ROUTE_IN_PROGRESS
  READY_FOR_NOTARY
  NOTARY_SCHEDULED
  REGISTRATION_OR_DISBURSEMENT
  SOLD
  FAILED
}

enum DealRoomTrafficLight {
  RED
  YELLOW
  GREEN_1
  GREEN_2
}

enum DealRoomPaymentRoute {
  CASH
  BVU
  OTBASY
  MIXED
}

enum DealDepositStatus {
  NOT_ALLOWED
  DRAFTING
  SENT
  SIGNED
  TRANSFER_PENDING
  RECEIVED
  CANCELLED
}

enum DealBookingStatus {
  NOT_CREATED
  PENDING_CONFIRMATION
  ACTIVE
  EXPIRING_SOON
  EXTENDED
  EXPIRED
  CANCELLED
  CONVERTED_TO_SOLD
}

enum DealRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SecondaryDeal {
  id            String               @id @default(cuid())
  propertyId    String               @map("property_id")
  buyerId       String               @map("buyer_id")
  offerId       String               @unique @map("offer_id")
  coordinatorId String?              @map("coordinator_id")
  stage         DealRoomStage        @default(OFFER_SUBMITTED)
  trafficLight  DealRoomTrafficLight @default(RED) @map("traffic_light")
  paymentRoute  DealRoomPaymentRoute? @map("payment_route")
  finalPrice    Decimal?             @map("final_price") @db.Decimal(15, 2)
  version       Int                  @default(1)
  outcomeAt     DateTime?            @map("outcome_at")
  outcomeReason String?              @map("outcome_reason") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  property    CrmProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer       Buyer       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  offer       Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  coordinator User?       @relation(fields: [coordinatorId], references: [id])

  precheck DealPrecheck?
  deposit  DealDeposit?
  booking  DealBooking?
  risks    DealRisk[]
  commission Commission?
  fixation   SecondaryFixation? @relation("FixationDeal")

  // Раздел 5 из 05_CASA_Data_API_Security: не более одного active Deal на
  // property_id + buyer_id — гарантируется на уровне сервиса (частичный
  // уникальный индекс по активным стадиям не выразим декларативно в Prisma).
  @@index([propertyId])
  @@index([buyerId])
  @@index([stage])
  @@map("secondary_deals")
}

// Раздел 3: "Покупатель, продавец, объект, маршрут оплаты, completeness,
// traffic light".
model DealPrecheck {
  id                    String   @id @default(cuid())
  dealId                String   @unique @map("deal_id")
  buyerVerified         Boolean  @default(false) @map("buyer_verified")
  sellerVerified        Boolean  @default(false) @map("seller_verified")
  propertyVerified      Boolean  @default(false) @map("property_verified")
  paymentRouteConfirmed Boolean  @default(false) @map("payment_route_confirmed")
  completenessPercent   Int      @default(0) @map("completeness_percent")
  hasBlockingRisk       Boolean  @default(false) @map("has_blocking_risk")
  missingAmount         Decimal  @default(0) @map("missing_amount") @db.Decimal(15, 2)
  mortgagePartConfirmed Boolean  @default(true) @map("mortgage_part_confirmed") // true (n/a) unless route requires financing
  notes                 String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  deal SecondaryDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("deal_prechecks")
}

// Раздел 6: not_allowed → drafting → sent → signed → transfer_pending →
// received | cancelled. Раздел 7: booking_active требует signed + proof +
// coordinator_verification=true. CASA не принимает задаток напрямую —
// proofFileAssetId ссылается на подтверждающий документ (банковский перевод,
// расписка), не на сам платёж.
model DealDeposit {
  id                 String            @id @default(cuid())
  dealId             String            @unique @map("deal_id")
  amount             Decimal?          @db.Decimal(15, 2)
  contractRef        String?           @map("contract_ref")
  status             DealDepositStatus @default(NOT_ALLOWED)
  proofType          String?           @map("proof_type") // bank_transfer | receipt | seller_confirmation | other
  proofFileAssetId   String?           @map("proof_file_asset_id")
  coordinatorVerified Boolean          @default(false) @map("coordinator_verified")
  verifiedBy         String?           @map("verified_by")
  verifiedAt         DateTime?         @map("verified_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  deal SecondaryDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("deal_deposits")
}

// Раздел 6: not_created → pending_confirmation → active → expiring_soon →
// extended → expired | cancelled | converted_to_sold. По умолчанию срок
// брони зависит от маршрута оплаты (cash 3-7 дн., BVU 10-14, Otbasy 14-30 —
// см. booking.cash_days/bvu_days/otbasy_days в ConfigVersion).
model DealBooking {
  id                  String             @id @default(cuid())
  dealId              String             @unique @map("deal_id")
  status              DealBookingStatus  @default(NOT_CREATED)
  expiryAt            DateTime?          @map("expiry_at")
  coordinatorVerified Boolean            @default(false) @map("coordinator_verified")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  deal SecondaryDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@map("deal_bookings")
}

model DealRisk {
  id          String           @id @default(cuid())
  dealId      String           @map("deal_id")
  category    String
  severity    DealRiskSeverity @default(MEDIUM)
  isBlocker   Boolean          @default(false) @map("is_blocker")
  ownerId     String?          @map("owner_id")
  dueDate     DateTime?        @map("due_date")
  resolution  String?          @db.Text
  resolvedAt  DateTime?        @map("resolved_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  deal  SecondaryDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  owner User?         @relation(fields: [ownerId], references: [id])

  @@index([dealId])
  @@map("deal_risks")
}

// =========================================
// CONSENT (CASA Mortgage Pre-Score v1.1 + Vtorichka gap-audits — shared
// Foundation). Purpose-specific, versioned client consent: a blanket
// "consent" checkbox is not enough per either handoff package. A revision
// is immutable once ACTIVE; withdrawal creates a new REVOKED revision
// rather than mutating the old one.
// =========================================

enum ConsentRevisionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  REVOKED
  SUPERSEDED
}

model ClientConsent {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  revisions ConsentRevision[]

  @@index([clientId])
  @@map("client_consents")
}

model ConsentRevision {
  id                 String                @id @default(cuid())
  consentId          String                @map("consent_id")
  purposeCode        String                @map("purpose_code") // e.g. "mortgage_prescore", "vtorichka_deal_room"
  purposeDescription String                @map("purpose_description") @db.Text
  allowedOperations  String[]              @map("allowed_operations")
  dataCategories     String[]              @map("data_categories")
  sourceChannel      String?               @map("source_channel")
  legalTextVersion   String                @map("legal_text_version")
  legalTextHash      String?               @map("legal_text_hash")
  evidenceType       String?               @map("evidence_type")
  evidenceRef        String?               @map("evidence_ref")
  status             ConsentRevisionStatus @default(DRAFT)
  grantedAt          DateTime?             @map("granted_at")
  expiresAt          DateTime?             @map("expires_at")
  revokedAt          DateTime?             @map("revoked_at")
  supersedesId       String?               @map("supersedes_id")
  createdAt          DateTime              @default(now()) @map("created_at")

  consent                 ClientConsent            @relation(fields: [consentId], references: [id], onDelete: Cascade)
  mortgageCaseParties     MortgageCaseParty[]
  mortgageRecipientGrants MortgageRecipientGrant[]

  @@index([consentId])
  @@index([purposeCode, status])
  @@map("consent_revisions")
}

// =========================================
// MORTGAGE RULE VERSIONING (CASA Mortgage Pre-Score v1.1 — Foundation only)
// Replaces the flat, unversioned MortgageProgram for future use. Critically:
// regulatory KDN formula, bank program affordability, and CASA's internal
// safety buffer are three SEPARATE rule types — the audited spec's central
// finding was that mixing them into one ratio (as the live scoring.service.ts
// currently does) hides which authority a number actually comes from.
// Not wired to any route yet — schema only, per user decision.
// =========================================

enum MortgageRuleType {
  REGULATORY_METRIC       // e.g. КДН formula per НБК №52 — Legal-owned
  PROGRAM_AFFORDABILITY   // bank/product-specific eligibility — Bank Partner-owned
  CASA_SAFETY_POLICY      // internal diagnostic buffer — Product-owned, never a hard bank rule
}

enum MortgageRuleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  RETIRED
  REJECTED
}

model MortgageRuleVersion {
  id            String              @id @default(cuid())
  ruleType      MortgageRuleType    @map("rule_type")
  bankName      String?             @map("bank_name")
  programName   String?             @map("program_name")
  versionNumber Int                 @map("version_number")
  status        MortgageRuleStatus  @default(DRAFT)
  // Structured groups from the spec (identity/property/borrower/income/
  // credit/affordability/pricing/governance/safety) — kept as JSON payload
  // rather than one column per nested bank field; governance metadata below
  // is real columns so lifecycle/audit queries don't need to parse JSON.
  payload       Json
  sourceUrl     String?             @map("source_url")
  sourceHash    String?             @map("source_hash")
  effectiveFrom DateTime?           @map("effective_from")
  effectiveTo   DateTime?           @map("effective_to")
  authorId      String?             @map("author_id")
  approverId    String?             @map("approver_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  author   User? @relation("MortgageRuleAuthor", fields: [authorId], references: [id])
  approver User? @relation("MortgageRuleApprover", fields: [approverId], references: [id])

  // Author != approver is a spec requirement (self-approval forbidden) —
  // enforced at the service layer, not expressible as a DB constraint.
  @@unique([bankName, programName, ruleType, versionNumber])
  @@index([ruleType, status])
  @@map("mortgage_rule_versions")
}

enum ReasonCodeSeverity {
  BLOCKING
  WARNING
  INFO
}

// Immutable registry (11.3 Reason Code Registry) — an unversioned code
// string in application logic can't be contract-tested; this makes the set
// of valid codes queryable and auditable.
model ReasonCode {
  code        String             @id
  dimension   String
  severity    ReasonCodeSeverity
  messageKey  String             @map("message_key")
  description String             @db.Text
  nextStep    String?            @map("next_step") @db.Text
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("reason_codes")
}

// =========================================
// MORTGAGE PRE-SCORE PERSISTENCE FOUNDATION
// Audited v1.1: case ownership, party consent, recipient grants,
// actor-scoped idempotency and append-only PII-safe audit.
// =========================================

enum MortgageCaseStatus {
  DRAFT
  CONSENT_PENDING
  DOCUMENTS_PENDING
  PROCESSING
  REVIEW_REQUIRED
  READY_TO_CALCULATE
  ACTIVE
  CONSENT_REVOKED
  CANCELLED
  ARCHIVED
}

enum MortgagePartyRole {
  PRIMARY
  CO_BORROWER
  GUARANTOR
}

enum MortgageRecipientType {
  BANK
  DEVELOPER
  OTHER
}

enum MortgageRecipientGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model MortgageCase {
  id               String             @id @default(cuid())
  clientId         String             @map("client_id")
  ownerId          String             @map("owner_id")
  status           MortgageCaseStatus @default(DRAFT)
  version          Int                @default(1)
  latestSnapshotId String?            @map("latest_snapshot_id")
  latestResultId   String?            @map("latest_result_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  client               Client                        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  owner                User                          @relation("MortgageCaseOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  parties              MortgageCaseParty[]
  grants               MortgageRecipientGrant[]
  auditEvents          MortgageAuditEvent[]
  calculationRuns      MortgageCalculationRun[]
  calculationSnapshots MortgageCalculationSnapshot[]
  clientProfile        MortgageClientProfile?
  profileSnapshots     MortgageClientProfileSnapshot[]
  clientCheckBatches   ClientCheckBatch[]

  @@index([clientId])
  @@index([ownerId, status])
  @@map("mortgage_cases")
}

model MortgageCaseParty {
  id                String            @id @default(cuid())
  caseId            String            @map("case_id")
  clientId          String            @map("client_id")
  role              MortgagePartyRole
  /// M01: семейная связь НЕ равна созаёмщику. SPOUSE — false до явного выбора,
  /// CO-BORROWER — только после явного включения (M01-CAN-0139/0140).
  /// Поэтому значение по умолчанию false, а не «включён, раз добавлен».
  includedInAnalysis Boolean          @default(false) @map("included_in_analysis")
  consentRevisionId String?           @map("consent_revision_id")
  createdAt         DateTime          @default(now()) @map("created_at")

  mortgageCase    MortgageCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consentRevision ConsentRevision? @relation(fields: [consentRevisionId], references: [id], onDelete: SetNull)
  documents       MortgageDocument[]
  snapshots       MortgageVerifiedSnapshot[]

  @@unique([caseId, clientId, role])
  @@unique([id, caseId, clientId])
  @@index([clientId])
  @@index([consentRevisionId])
  @@map("mortgage_case_parties")
}

model MortgageRecipientGrant {
