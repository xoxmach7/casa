  "acceptance_tests": [
    {
      "id": "AC-001",
      "priority": "P0",
      "given": "У клиента нет активного согласия",
      "when": "Специалист пытается загрузить PDF или запустить проверку по ИИН",
      "then": "Действие заблокировано, показана причина и кнопка отправки SMS-согласия"
    },
    {
      "id": "AC-002",
      "priority": "P0",
      "given": "Клиент открыл защищенную ссылку и ввел правильный одноразовый код",
      "when": "Он подтверждает актуальную версию текста согласия",
      "then": "Согласие получает статус confirmed, сохраняется неизменяемый аудит, специалист видит обновление без перезагрузки"
    },
    {
      "id": "AC-003",
      "priority": "P0",
      "given": "Загружены кредитная история и выписка ЕНПФ",
      "when": "Распознавание завершено",
      "then": "Поля показаны с источником и уверенностью; низкая уверенность требует ручного подтверждения"
    },
    {
      "id": "AC-004",
      "priority": "P0",
      "given": "Есть неполные или противоречивые данные",
      "when": "Запускается анализ",
      "then": "Ни одна программа не получает зеленый вердикт; система перечисляет недостающие поля"
    },
    {
      "id": "AC-005",
      "priority": "P0",
      "given": "Клиент не проходит из-за долговой нагрузки",
      "when": "CASA строит сценарии",
      "then": "Показаны минимум рефинансирование, частичное досрочное погашение с уменьшением платежа и подтверждение дополнительного дохода, если применимо"
    },
    {
      "id": "AC-006",
      "priority": "P0",
      "given": "Для рефинансирования нет проверенной ставки или предложения",
      "when": "Сценарий открыт",
      "then": "Система просит ввести подтвержденные условия и не показывает выдуманный итог"
    },
    {
      "id": "AC-007",
      "priority": "P0",
      "given": "Специалист вводит сумму частичного погашения",
      "when": "Выбран режим уменьшения платежа",
      "then": "CASA показывает старый и новый платеж, изменение КДН, открывшиеся программы и необходимость получить новый график"
    },
    {
      "id": "AC-008",
      "priority": "P0",
      "given": "Специалист добавляет дополнительный доход",
      "when": "Программа не принимает выбранный тип подтверждения",
      "then": "Доход не включается в принимаемую базу и показывается объяснение"
    },
    {
      "id": "AC-009",
      "priority": "P0",
      "given": "Специалист меняет стоимость квартиры, взнос или долг",
      "when": "Поле изменено",
      "then": "Платеж, КДН, программы и квартиры пересчитываются не позднее 500 мс на p95"
    },
    {
      "id": "AC-010",
      "priority": "P0",
      "given": "Выбран финансовый сценарий",
      "when": "Система запрашивает подбор недвижимости",
      "then": "В конце экрана показаны только подходящие или условно подходящие новостройки с причиной статуса и свежестью данных"
    },
    {
      "id": "AC-011",
      "priority": "P0",
      "given": "Версия программы устарела или требует ручного подтверждения",
      "when": "Клиент формально соответствует правилам",
      "then": "Вердикт не становится зеленым; указаны дата и источник последней проверки"
    },
    {
      "id": "AC-012",
      "priority": "P0",
      "given": "Расчет сохранен",
      "when": "Позже опубликована новая версия программы",
      "then": "Старый расчет воспроизводится по прежнему снимку клиента и прежней версии правил"
    },
    {
      "id": "AC-013",
      "priority": "P0",
      "given": "Клиент отозвал согласие",
      "when": "Пользователь открывает документы или публичную ссылку",
      "then": "Новая обработка и доступ блокируются, событие записывается в аудит"
    },
    {
      "id": "AC-014",
      "priority": "P0",
      "given": "Создано заключение клиента",
      "when": "Открывается публичная ссылка или PDF",
      "then": "Видны варианты, цифры, плюсы, ограничения и следующие шаги; внутренние заметки, полный ИИН и исходные документы скрыты"
    },
    {
      "id": "AC-015",
      "priority": "P1",
      "given": "Источник проверки по ИИН недоступен",
      "when": "Проверка завершилась ошибкой",
      "then": "CASA показывает source_unavailable, а не verified_no_records, и предлагает ручную проверку"
    }
  ],
