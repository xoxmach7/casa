// =========================================
// MORTGAGE DOCUMENT + VERIFIED SNAPSHOT WORKFLOW
// Upload state stays mutable on MortgageDocument. A revision is created only
// after scan/extraction and is append-only; corrections create a new revision.
// Snapshot payloads are encrypted by an approved adapter before persistence.
// =========================================

enum MortgageDocumentType {
  CREDIT_HISTORY
  ENPF_STATEMENT
  IDENTITY
  OTHER
}

enum MortgageDocumentStatus {
  UPLOAD_PENDING
  UPLOADED
  SCAN_PENDING
  SCAN_CLEAN
  SCAN_REJECTED
  EXTRACTION_PENDING
  MANUAL_REVIEW_REQUIRED
  CONFIRMED
  PROCESSING_FAILED
}

enum MortgageFieldPresence {
  PRESENT
  EXPLICIT_ZERO
  BLANK
  NOT_APPLICABLE
  UNREADABLE
  UNKNOWN
  NOT_IN_TEMPLATE
}

enum MortgageFieldReviewStatus {
  UNREVIEWED
  AUTO_ACCEPTED
  MANUAL_REVIEW_REQUIRED
  CONFIRMED
  REJECTED
}

enum MortgageFieldValueType {
  MONEY
  DECIMAL
  INTEGER
  BOOLEAN
  DATE
  DATETIME
  CODE
  HASH_ONLY
}

enum MortgageEncryptionAlgorithm {
  AES_256_GCM
}

model MortgageDocument {
  id                String                 @id @default(cuid())
  caseId            String                 @map("case_id")
  clientId          String                 @map("client_id")
  partyId           String                 @map("party_id")
  type              MortgageDocumentType
  status            MortgageDocumentStatus @default(UPLOAD_PENDING)
  currentRevisionId String?                @map("current_revision_id")
  uploadedById      String                 @map("uploaded_by_id")
  issuedAt          DateTime?              @map("issued_at")
  validUntil        DateTime?              @map("valid_until")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  party           MortgageCaseParty          @relation(fields: [partyId, caseId, clientId], references: [id, caseId, clientId], onDelete: Restrict)
  uploadedBy      User                       @relation("MortgageDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  revisions       MortgageDocumentRevision[] @relation("MortgageDocumentRevisions")
  currentRevision MortgageDocumentRevision?  @relation("CurrentMortgageDocumentRevision", fields: [id, currentRevisionId], references: [documentId, id], onDelete: Restrict)

  @@index([caseId, status])
  @@unique([id, currentRevisionId])
  @@index([clientId, type])
  @@map("mortgage_documents")
}

model MortgageDocumentRevision {
  id               String                 @id @default(cuid())
  documentId       String                 @map("document_id")
  version          Int
  objectKey        String                 @map("object_key")
  sha256           String
  mimeType         String                 @map("mime_type")
  sizeBytes        BigInt                 @map("size_bytes")
  pageCount        Int?                   @map("page_count")
  status           MortgageDocumentStatus
  extractorVersion String?                @map("extractor_version")
  extractionHash   String?                @map("extraction_hash")
  createdById      String                 @map("created_by_id")
  createdAt        DateTime               @default(now()) @map("created_at")

  document        MortgageDocument                 @relation("MortgageDocumentRevisions", fields: [documentId], references: [id], onDelete: Restrict)
  currentFor      MortgageDocument?                @relation("CurrentMortgageDocumentRevision")
  createdBy       User                             @relation("MortgageDocumentRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fields          MortgageFieldReview[]
  snapshotSources MortgageSnapshotDocumentSource[]

  @@unique([documentId, version])
  @@unique([documentId, id])
  @@index([sha256])
  @@map("mortgage_document_revisions")
}

model MortgageFieldReview {
  id                 String                    @id @default(cuid())
  documentRevisionId String                    @map("document_revision_id")
  fieldKey           String                    @map("field_key")
  version            Int
  isCritical         Boolean                   @default(false) @map("is_critical")
  valueType          MortgageFieldValueType?   @map("value_type")
  normalizedDecimal  Decimal?                  @map("normalized_decimal") @db.Decimal(20, 6)
  normalizedCode     String?                   @map("normalized_code") @db.VarChar(64)
  normalizedDate     DateTime?                 @map("normalized_date")
  normalizedBoolean  Boolean?                  @map("normalized_boolean")
  valueHash          String?                   @map("value_hash")
  presence           MortgageFieldPresence
  confidence         Decimal?                  @db.Decimal(5, 4)
  sourcePage         Int?                      @map("source_page")
  sourceBboxX        Decimal?                  @map("source_bbox_x") @db.Decimal(10, 6)
  sourceBboxY        Decimal?                  @map("source_bbox_y") @db.Decimal(10, 6)
  sourceBboxWidth    Decimal?                  @map("source_bbox_width") @db.Decimal(10, 6)
  sourceBboxHeight   Decimal?                  @map("source_bbox_height") @db.Decimal(10, 6)
  evidenceHash       String?                   @map("evidence_hash")
  reviewStatus       MortgageFieldReviewStatus @default(UNREVIEWED) @map("review_status")
  reviewedById       String?                   @map("reviewed_by_id")
  reviewedAt         DateTime?                 @map("reviewed_at")
  supersedesReviewId String?                   @map("supersedes_review_id")
  createdAt          DateTime                  @default(now()) @map("created_at")

  documentRevision MortgageDocumentRevision       @relation(fields: [documentRevisionId], references: [id], onDelete: Restrict)
  reviewedBy       User?                          @relation("MortgageFieldReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  supersedes       MortgageFieldReview?           @relation("MortgageFieldReviewSupersession", fields: [supersedesReviewId], references: [id], onDelete: Restrict)
  supersededBy     MortgageFieldReview[]           @relation("MortgageFieldReviewSupersession")
  snapshotSources  MortgageSnapshotReviewSource[]

  @@unique([documentRevisionId, fieldKey, version])
  @@index([documentRevisionId, fieldKey])
  @@index([reviewStatus])
  @@map("mortgage_field_reviews")
}

model MortgageVerifiedSnapshot {
  id                   String   @id @default(cuid())
  caseId               String   @map("case_id")
  clientId             String   @map("client_id")
  partyId              String   @map("party_id")
  version              Int
  payloadSchemaVersion String   @map("payload_schema_version")
  encryptedPayload     Bytes    @map("encrypted_payload")
  encryptionKeyRef     String   @map("encryption_key_ref")
  encryptionAlgorithm  MortgageEncryptionAlgorithm @map("encryption_algorithm")
  encryptionIv         Bytes    @map("encryption_iv")
  encryptionAuthTag    Bytes    @map("encryption_auth_tag")
  contentHash          String   @map("content_hash")
  confirmedById        String   @map("confirmed_by_id")
  confirmedAt          DateTime @default(now()) @map("confirmed_at")
  createdAt            DateTime @default(now()) @map("created_at")

  party           MortgageCaseParty                @relation(fields: [partyId, caseId, clientId], references: [id, caseId, clientId], onDelete: Restrict)
  confirmedBy     User                             @relation("MortgageSnapshotConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  documentSources MortgageSnapshotDocumentSource[]
  reviewSources   MortgageSnapshotReviewSource[]

  @@unique([caseId, version])
  @@unique([encryptionKeyRef, encryptionIv])
  @@index([clientId, confirmedAt])
  @@index([contentHash])
  @@map("mortgage_verified_snapshots")
}

model MortgageSnapshotDocumentSource {
  snapshotId String @map("snapshot_id")
  revisionId String @map("revision_id")

  snapshot MortgageVerifiedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  revision MortgageDocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@id([snapshotId, revisionId])
  @@index([revisionId])
  @@map("mortgage_snapshot_document_sources")
}

model MortgageSnapshotReviewSource {
  snapshotId String @map("snapshot_id")
  reviewId   String @map("review_id")

  snapshot MortgageVerifiedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  review   MortgageFieldReview      @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@id([snapshotId, reviewId])
  @@index([reviewId])
  @@map("mortgage_snapshot_review_sources")
}
// =========================================
// PUBLIC LISTING OPS (casa40-main integration, 2026-08-02)
// Лёгкая админка сайта casa.kz (простой статус-флоу new→published→showing→
// in_deal, приём оплаты риелторского вознаграждения, чек-лист документов) —
// сознательно НЕ объединена с полноценной брокерской CRM-воронкой
// (crm-properties.routes.ts/Show/Offer/Deal). Хранит своё состояние поверх
// той же CrmProperty (публичная карточка объекта уже там), но со своими
// правилами и без брокерских полей funnelStage/strategy/liquidity.
// =========================================

enum PublicListingStatus {
  NEW
  PUBLISHED
  SHOWING
  IN_DEAL
  ARCHIVED
}

enum PublicListingPaymentStatus {
  UNPAID
  PAID
}

model PublicListingOps {
  id                    String                      @id @default(cuid())
  propertyId            String                      @unique @map("property_id")
  status                PublicListingStatus         @default(NEW)
  selectedLeadId        String?                     @map("selected_lead_id")
  paymentStatus         PublicListingPaymentStatus  @default(UNPAID) @map("payment_status")
  paymentAmount         Decimal?                    @map("payment_amount") @db.Decimal(15, 2)
  paymentReceiptFileId  String?                     @map("payment_receipt_file_id")
  paymentComment        String?                     @map("payment_comment") @db.Text
  verificationChecklist Json?                       @map("verification_checklist")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  property     CrmProperty        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  selectedLead PublicListingLead? @relation("SelectedLead", fields: [selectedLeadId], references: [id])

  @@map("public_listing_ops")
}

// FK'd directly to CrmProperty (not PublicListingOps) — a lead can arrive
// before any admin has touched PublicListingOps for that property, so ops
// state is created lazily on first admin action, not required upfront.
model PublicListingLead {
  id               String    @id @default(cuid())
  propertyId       String    @map("property_id")
  buyerName        String    @map("buyer_name")
  buyerPhone       String    @map("buyer_phone")
  status           String    @default("new")
  comment          String?   @db.Text
  financingType    String?   @map("financing_type")
  financingBank    String?   @map("financing_bank")
  preApproved      Boolean?  @map("pre_approved")
  mortgageAmount   Decimal?  @map("mortgage_amount") @db.Decimal(15, 2)
  expectedTimeline String?   @map("expected_timeline")
  viewingDatetime  DateTime? @map("viewing_datetime")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  property    CrmProperty       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  selectedFor PublicListingOps[] @relation("SelectedLead")

  @@index([propertyId])
  @@map("public_listing_leads")
}

// "Запросить доступ" form on the CRM marketing landing (both / and /gpt-taste
// variants) — unauthenticated submission, held for ADMIN moderation before
// anyone acts on it.
model LandingLead {
  id           String    @id @default(cuid())
  name         String
  phone        String
  role         String    // one of the landing form's role options, free text
  source       String    @default("landing") // which page variant submitted
  status       String    @default("NEW") // NEW, CONTACTED, REJECTED
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("landing_leads")
}

// =========================================
// M02 R0 — IIN CHECK (официальные реестры)
//
// Источник: M02_CASA_Pro_IIN_Check_R0_Implementation_and_Acceptance_v1.0.
// R0 работает ПОЛНОСТЬЮ без внешних production-вызовов: коннекторы выключены
// deny-by-default, маршруты — manual / client-authorized / unavailable.
// SmartBridge и официальные API — это R1/R2 и НЕ являются условием готовности R0.
//
// Полный ИИН здесь не хранится: субъект адресуется borrower reference +
// HMAC-токеном поиска + маской (§7, §16).
// =========================================

/// Техническое состояние проверки — отдельно от бизнес-исхода (§10).
enum ClientCheckStatus {
  QUEUED
  RUNNING
  COMPLETED
  MANUAL_REQUIRED
  BLOCKED
  UNAVAILABLE
  ERROR
  NOT_ALLOWED
}

/// Бизнес-исход. UNKNOWN — самостоятельное значение: не 0, не false, не «чисто».
enum ClientCheckOutcome {
  FOUND
  NOT_FOUND
  ZERO
  NOT_APPLICABLE
  UNKNOWN
}

enum ClientCheckOverallStatus {
  COMPLETE_FACTS_FOUND
  COMPLETE_NO_RECORDS
  PARTIAL
  BLOCKED_CONSENT
  BLOCKED_LEGAL
  STALE
}

enum ManualCheckTaskStatus {
  OPEN
  IN_PROGRESS
  CONFIRMED
  EXPIRED
  CANCELLED
}

/// Один запуск проверки: participant identity_version + consent + frozen manifest.
/// Иммутабелен. Обновление — это НОВЫЙ batch со ссылкой supersedes_id (§13).
model ClientCheckBatch {
  id        String @id @default(cuid())
  /// Область доступа M01. Отдельной сущности tenant в модели нет — областью
  /// является владелец кейса; вид фиксируется явно (как в M06).
  tenantId  String @map("tenant_id")
  tenantScopeKind String @default("CASE_OWNER") @map("tenant_scope_kind")
  caseId    String @map("case_id")
  partyId   String @map("party_id")
  /// Ссылка на субъекта БЕЗ ИИН: маска для человека + HMAC-токен для поиска.
  borrowerRef       String  @map("borrower_ref")
  iinMasked         String  @map("iin_masked")
  iinLookupToken    String  @map("iin_lookup_token")
  identityVersion   Int     @map("identity_version")
  consentRevisionId String? @map("consent_revision_id")
  consentPurpose    String  @map("consent_purpose")
  /// Замороженный манифест: знаменатель покрытия берётся отсюда, а НЕ из
  /// живого реестра — дрейф реестра не меняет уже выполненный прогон (§9).
  manifestVersion   String @map("manifest_version")
  registryVersion   String @map("registry_version")
  manifestJson      Json   @map("manifest_json")
  requiredTotal     Int    @map("required_total")
  actorId     String   @map("actor_id")
  requestedAt DateTime @default(now()) @map("requested_at")
  overallStatus ClientCheckOverallStatus @map("overall_status")
  coverageJson  Json                     @map("coverage_json")
  /// Блокер до маршрута: невалидный ИИН, нет согласия, не закрыт legal gate.
  blockerCode String? @map("blocker_code")
  idempotencyKey String @map("idempotency_key")
  requestHash    String @map("request_hash")
  /// Иммутабельная история: refresh не правит старый batch, а создаёт новый.
  supersedesId   String? @map("supersedes_id")
  supersededById String? @map("superseded_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  mortgageCase MortgageCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  results      ClientCheckResult[]
  manualTasks  ManualCheckTask[]

  @@index([caseId, createdAt])
  @@index([tenantId])
  @@index([iinLookupToken])
  @@map("client_check_batches")
}

/// Результат по паре источник × check_type. Иммутабелен; исправление —
/// новая запись с supersedes_id.
model ClientCheckResult {
  id      String @id @default(cuid())
  batchId String @map("batch_id")
  tenantId String @map("tenant_id")
  sourceCode     String @map("source_code")
  sourceOwner    String @map("source_owner")
  sourceUrl      String @map("source_url")
  checkType      String @map("check_type")
  automationMode String @map("automation_mode")
  /// Входит ли в знаменатель покрытия этого batch.
  required Boolean @default(true)
  /// status и outcome — РАЗНЫЕ поля: «не выполнено» ≠ «ничего не найдено».
  status  ClientCheckStatus
  outcome ClientCheckOutcome?
  /// Категория ошибки §12; null при успешном исходе.
  errorCategory String? @map("error_category")
  retryable     Boolean @default(false)
  reason        String  @db.Text
  upstreamCode  String? @map("upstream_code")
  /// Три РАЗНЫЕ временные характеристики (§13); null означает явный UNKNOWN.
  checkedAt      DateTime? @map("checked_at")
  sourceDataAsOf DateTime? @map("source_data_as_of")
  freshUntil     DateTime? @map("fresh_until")
  legalBasisStatus String? @map("legal_basis_status")
  consentRevisionId String? @map("consent_revision_id")
  approvalId        String? @map("approval_id")
  /// Evidence обязателен для completed-исхода (§14); raw payload не хранится.
  evidenceRef       String? @map("evidence_ref")
  evidenceHash      String? @map("evidence_hash")
  retentionPolicyId String? @map("retention_policy_id")
  attempt        Int     @default(1)
  supersedesId   String? @map("supersedes_id")
  supersededById String? @map("superseded_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  batch       ClientCheckBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  facts       ClientCheckFact[]
  manualTasks ManualCheckTask[]

  @@index([batchId])
  @@index([tenantId])
  @@map("client_check_results")
}

/// Иммутабельный нормализованный факт источника. Только allowlisted поля —
/// данные третьих лиц и raw payload не сохраняются (§10 RAW MINIMIZATION).
model ClientCheckFact {
  id        String   @id @default(cuid())
  resultId  String   @map("result_id")
  tenantId  String   @map("tenant_id")
  factKey   String   @map("fact_key")
  factValue Json     @map("fact_value")
  createdAt DateTime @default(now()) @map("created_at")

  result ClientCheckResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("client_check_facts")
}

/// Ручная проверка на официальном сайте. Подтверждение БЕЗ evidence запрещено:
/// кнопка «записей нет» сама по себе не является доказательством (§11).
model ManualCheckTask {
  id       String @id @default(cuid())
  batchId  String @map("batch_id")
  resultId String @map("result_id")
  tenantId String @map("tenant_id")
  sourceCode String @map("source_code")
  checkType  String @map("check_type")
  /// Только базовый официальный URL — без ИИН в query/path/referrer (§11).
  officialUrl String @map("official_url")
  instruction String @db.Text
  assigneeId String?   @map("assignee_id")
  dueAt      DateTime? @map("due_at")
  expiresAt  DateTime? @map("expires_at")
  status  ManualCheckTaskStatus @default(OPEN)
  outcome ClientCheckOutcome?
  evidenceRef  String? @map("evidence_ref")
  evidenceHash String? @map("evidence_hash")
  checkedAt      DateTime? @map("checked_at")
  sourceDataAsOf DateTime? @map("source_data_as_of")
  freshUntil     DateTime? @map("fresh_until")
  confirmedByActorId String?   @map("confirmed_by_actor_id")
  confirmedAt        DateTime? @map("confirmed_at")
  comment            String?   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batch  ClientCheckBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  result ClientCheckResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([tenantId, status])
  @@map("manual_check_tasks")
}

// =========================================
// ПОРТАЛ ВТОРИЧКИ
// Спека: docs/superpowers/specs/2026-09-03-vtorichka-marketplace-business-model-design.md
//
// Модель: объекты выкладывает только собственник; агент приходит
// исключительно с покупателем и обязан зафиксировать его на объекте.
// Комиссию платит собственник при закрытии, из неё агенту покупателя
// причитается объявленная доля.
// =========================================

// Кто завёл объект вторички.
enum ListingSource {
  LEGACY      // создан до появления контура (все существующие записи)
  OWNER_SELF  // собственник через свой кабинет
  COORDINATOR // сотрудник CASA от имени собственника
}

// Уровень договора с собственником. Различаются экономически, а не
// риторически: см. раздел 5.2 спеки.
enum ListingTier {
  BASIC     // без эксклюзива: комиссия выше, услуг меньше, маскировка жёстче
  EXCLUSIVE // эксклюзив: комиссия ниже, полный пакет услуг, приоритет в выдаче
}

enum ListingAgreementStatus {
  DRAFT      // создан, собственник ещё не принял условия
  ACTIVE     // принят — объект допущен к публикации
  EXPIRED    // истёк срок
  TERMINATED // расторгнут
}

// Договор с собственником. Гейт публикации: нет активного договора —
// объекта в базе нет. Обязательство по комиссии возникает здесь, в момент
// публикации, а не в момент сделки — иначе обход платформы ничем не
// удерживается (раздел 3, Р-1/Р-2 спеки).
model ListingAgreement {
  id                     String                 @id @default(cuid())
  propertyId             String                 @map("property_id")
  sellerId               String                 @map("seller_id")
  tier                   ListingTier            @default(BASIC)
  // Процент от цены сделки, который платит собственник.
  commissionPercent      Decimal                @map("commission_percent") @db.Decimal(5, 2)
  // Доля агента покупателя ВНУТРИ комиссии, в процентах. Показывается агенту
  // на карточке объекта до фиксации — без объявленного сплита он не приведёт
  // покупателя к чужой квартире.
  buyerAgentSharePercent Decimal                @map("buyer_agent_share_percent") @db.Decimal(5, 2)
  // Сколько дней после истечения фиксации сделка с тем же покупателем всё
  // ещё порождает комиссию.
  protectionPeriodDays   Int                    @map("protection_period_days")
  status                 ListingAgreementStatus @default(DRAFT)
  acceptedAt             DateTime?              @map("accepted_at")
  // Чем подтверждено принятие условий: оферта в кабинете, скан документа.
  acceptanceEvidence     String?                @map("acceptance_evidence") @db.Text
  expiresAt              DateTime?              @map("expires_at")
  terminatedAt           DateTime?              @map("terminated_at")
  terminationReason      String?                @map("termination_reason") @db.Text
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  property CrmProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seller   Seller      @relation(fields: [sellerId], references: [id])

  // Не более одного ACTIVE-договора на объект — держит
  // listing-agreement.service.ts: частичный уникальный индекс по статусу
  // декларативно в Prisma не выражается.
  @@index([propertyId])
  @@index([sellerId])
  @@index([status])
  @@map("listing_agreements")
}

// Статусы фиксации покупателя. По смыслу повторяют FixationStatus из
// новостроек, но живут отдельно: тот привязан к projectId и обслуживает
// живой контур застройщиков.
enum SecondaryFixationStatus {
  DRAFT
  SENT
  DUPLICATE_CHECK
  CONFIRMED
  SHOWN
  OFFER_MADE
  DEAL
  REJECTED_DUPLICATE
  REJECTED_OTHER
  EXPIRED
  CANCELLED
}

// Фиксация покупателя на объекте.
//
// Здесь у фиксации две работы, и вторая важнее первой: развести агентов
// между собой (дубль-чек) и ДОКАЗАТЬ, что покупателя привела платформа.
// Цепочка улик «фиксация → показ → оффер → сделка» и защитный период — то,
// на чём держится комиссия, когда собственник висит ещё и на Krisha.
model SecondaryFixation {
  id         String                  @id @default(cuid())
  propertyId String                  @map("property_id")
  buyerId    String                  @map("buyer_id")
  agentId    String                  @map("agent_id")
  agencyId   String?                 @map("agency_id")
  // Необратимый отпечаток личности покупателя (HMAC от ИИН или телефона).
  // По нему идёт дубль-чек и сверка при снятии объекта; полные ПД в поле
  // сравнения не хранятся.
  buyerIdentityHash String            @map("buyer_identity_hash")
  status     SecondaryFixationStatus @default(DRAFT)
  // Условия, действовавшие в момент фиксации. Снимок, а не ссылка:
  // договор может быть перезаключён, а обещание агенту — нет.
  declaredSharePercent Decimal        @map("declared_share_percent") @db.Decimal(5, 2)
  sentAt          DateTime?           @map("sent_at")
  confirmedAt     DateTime?           @map("confirmed_at")
  expiresAt       DateTime            @map("expires_at")
  protectionUntil DateTime            @map("protection_until")
  rejectionReason String?             @map("rejection_reason") @db.Text
  secondaryDealId String?             @unique @map("secondary_deal_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  property      CrmProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer         Buyer          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  agent         User           @relation("AgentFixations", fields: [agentId], references: [id])
  agency        User?          @relation("AgencyFixations", fields: [agencyId], references: [id])
  secondaryDeal SecondaryDeal? @relation("FixationDeal", fields: [secondaryDealId], references: [id])
  statusHistory SecondaryFixationStatusLog[]

  @@index([propertyId])
  @@index([agentId])
  @@index([status])
  @@index([buyerIdentityHash])
  @@index([propertyId, buyerIdentityHash])
  @@map("secondary_fixations")
}

model SecondaryFixationStatusLog {
  id         String                   @id @default(cuid())
  fixationId String                   @map("fixation_id")
  fromStatus SecondaryFixationStatus? @map("from_status")
  toStatus   SecondaryFixationStatus  @map("to_status")
  changedBy  String?                  @map("changed_by")
  note       String?                  @db.Text
  createdAt  DateTime                 @default(now()) @map("created_at")

  fixation SecondaryFixation @relation(fields: [fixationId], references: [id], onDelete: Cascade)

  @@index([fixationId])
  @@map("secondary_fixation_status_logs")
}

// Чем закончился листинг.
enum ListingExitOutcome {
  SOLD_VIA_PLATFORM // продано покупателю с площадки
  SOLD_OUTSIDE      // продано мимо площадки
  NOT_SOLD          // не продано
  WITHDRAWN         // снято собственником
}

// Снятие объекта с обязательным опросом — момент, в который рождается
// комиссия или спор. Снять объект, не заполнив это, нельзя.
model ListingExit {
  id                String             @id @default(cuid())
  propertyId        String             @map("property_id")
  outcome           ListingExitOutcome
  buyerIdentityHash String?            @map("buyer_identity_hash")
  declaredPrice     Decimal?           @map("declared_price") @db.Decimal(15, 2)
  declaredBy        String             @map("declared_by")
  comment           String?            @db.Text
  // Заполняется сверкой: нашлась ли фиксация, покрывающая этого покупателя.
  matchedFixationId String?            @map("matched_fixation_id")
  disputeOpened     Boolean            @default(false) @map("dispute_opened")
  createdAt         DateTime           @default(now()) @map("created_at")

  property  CrmProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  declarant User        @relation("ListingExitDeclarant", fields: [declaredBy], references: [id])

  @@index([propertyId])
  @@index([buyerIdentityHash])
  @@map("listing_exits")
}

// Тариф агентства на портале вторички.
enum MarketplacePlan {
  TRIAL // пробный: базовый доступ, жёсткие лимиты
  START
  PRO
  ENTERPRISE
}

enum MarketplaceSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Подписка агентства. Существующая Subscription висит на пользователе,
// ставится руками админом и не проверяется нигде в коде — как рычаг она
// не работает. Эта проверяется в middleware: без активной подписки агент
// не видит контакты и не может фиксировать.
model AgencySubscription {
  id        String                        @id @default(cuid())
  // Владелец подписки: пользователь с ролью AGENCY либо независимый агент.
  agencyId  String                        @map("agency_id")
  plan      MarketplacePlan               @default(TRIAL)
  status    MarketplaceSubscriptionStatus @default(ACTIVE)
  // Лимиты тарифа. Хранятся на подписке, а не в коде, чтобы менять их
  // конкретному агентству без релиза.
  maxActiveFixations Int                  @map("max_active_fixations")
  maxAgents          Int                  @map("max_agents")
  startsAt  DateTime                      @default(now()) @map("starts_at")
  expiresAt DateTime?                     @map("expires_at")
  amount    Decimal?                      @db.Decimal(15, 2)
  createdAt DateTime                      @default(now()) @map("created_at")
  updatedAt DateTime                      @updatedAt @map("updated_at")

  agency User @relation("AgencySubscriptions", fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([status])
  @@map("agency_subscriptions")
}
