// New Models for v1.2

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  content      String   @db.Text
  duration     Int // minutes
  order        Int      @default(0)
  videoUrl     String?  @map("video_url") // Ссылка на видеоурок
  materials    String[] @default([]) // Ссылки на материалы (PDF, DOC)
  checklist    String[] @default([]) // Пункты чек-листа для курса
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  progress CourseProgress[]
  test     CourseTest?

  @@map("courses")
}

// Итоговый тест курса — прохождение (score >= passScore) закрывает курс и,
// если закрыты ВСЕ активные курсы, переводит User.certificationStatus в
// CERTIFIED (см. certification.service.ts).
model CourseTest {
  id        String   @id @default(cuid())
  courseId  String   @unique @map("course_id")
  questions Json     // [{ question, options: string[], correctIndex }]
  passScore Int      @default(70) @map("pass_score") // процент правильных ответов
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts TestAttempt[]

  @@map("course_tests")
}

model TestAttempt {
  id        String   @id @default(cuid())
  testId    String   @map("test_id")
  userId    String   @map("user_id")
  score     Int // процент
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now()) @map("created_at")

  test CourseTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([userId])
  @@map("test_attempts")
}

model CourseProgress {
  id              String    @id @default(cuid())
  progressPercent Int       @default(0) @map("progress_percent")
  isCompleted     Boolean   @default(false) @map("is_completed")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  userId          String    @map("user_id")
  courseId        String    @map("course_id")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_progress")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  userId    String           @map("user_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  // Матчит точный where(userId, isRead?)+orderBy(createdAt) в notifications.routes.ts
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model MortgageProgram {
  id             String   @id @default(cuid())
  bankName       String   @map("bank_name")
  programName    String   @map("program_name")
  interestRate   Decimal  @map("interest_rate") @db.Decimal(5, 2)
  minDownPayment Decimal  @map("min_down_payment") @db.Decimal(5, 2) // percent
  maxTerm        Int      @map("max_term") // months
  propertyType   String   @map("property_type") // NEW_BUILDING, SECONDARY
  requirements   String   @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([bankName])
  @@index([propertyType])
  @@map("mortgage_programs")
}


model Deal {
  id          String     @id @default(cuid())
  amount      Decimal    @db.Decimal(15, 2)
  commission  Decimal    @db.Decimal(15, 2) // broker commission
  casaFee     Decimal    @map("casa_fee") @db.Decimal(15, 2) // Casa fee
  status      DealStatus @default(IN_PROGRESS)
  stage       DealStage  @default(CONSULTATION) // New: Kanban stage
  order       Int        @default(0) // New: Order in column
  color       String     @default("#3B82F6") // New: Card color
  source      String     @default("MANUAL") // New: MANUAL, FORM, BOT
  objectType  String     @map("object_type") // PROPERTY, APARTMENT, BOOKING
  objectId    String?    @map("object_id") // ID объекта (property/apartment)
  clientId    String?    @map("client_id") // покупатель
  notes       String?    @db.Text
  isTradeIn   Boolean    @default(false) @map("is_trade_in") // TradeIn сделка
  tradeInPropertyId String? @map("trade_in_property_id") // Старая квартира клиента
  tradeInProjectId  String? @map("trade_in_project_id")  // ЖК застройщика для обмена
  tradeInCommission Decimal? @map("trade_in_commission") @db.Decimal(5, 2) // % комиссии TradeIn
  completedAt DateTime?  @map("completed_at")
  // Отдельно от updatedAt: обновляется ТОЛЬКО при смене stage, чтобы ИИ-агент
  // мог надёжно посчитать "сколько сделка висит на текущем этапе" — updatedAt
  // меняется при любой правке сделки, не только при смене этапа.
  stageChangedAt DateTime @default(now()) @map("stage_changed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  brokerId    String     @map("broker_id")

  // Relations
  broker User    @relation(fields: [brokerId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
  agentActions DealAgentAction[]
  commissionRecord Commission?

  @@index([brokerId])
  @@index([clientId])
  @@index([status])
  @@index([stage])
  @@index([completedAt])
  @@map("deals")
}

// Комиссия по сделке — отдельная сущность со своим статусом и историей
// переходов, вместо просто числового поля на Deal (см. ТЗ раздел 10).
enum CommissionStatus {
  ESTIMATED           // Предварительная оценка при создании сделки
  EXPECTED            // Ожидается после подтверждения условий
  CONFIRMED           // Подтверждена событием сделки
  INVOICED            // Выставлен счёт
  RECEIVED            // Деньги получены CASA
  PAYABLE_TO_PARTNER  // Причитается партнёру/брокеру к выплате
  PAID                // Выплачена
  DISPUTED            // Спорная
  CANCELLED           // Отменена
}

// Комиссия обслуживает обе сделки: `dealId` — канбан новостроек, а
// `secondaryDealId` — сделка вторички. Ровно одна из двух ссылок заполнена;
// инвариант держит commission.service.ts, потому что Prisma не выражает
// декларативно «XOR по двум nullable-полям».
model Commission {
  id              String           @id @default(cuid())
  dealId          String?          @unique @map("deal_id")
  secondaryDealId String?          @unique @map("secondary_deal_id")
  amount          Decimal          @db.Decimal(15, 2)
  casaShare       Decimal?         @map("casa_share") @db.Decimal(15, 2)
  partnerShare    Decimal?         @map("partner_share") @db.Decimal(15, 2)
  // Кому причитается partnerShare на вторичке — агент, приведший покупателя.
  partnerAgentId  String?          @map("partner_agent_id")
  status          CommissionStatus @default(ESTIMATED)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  deal          Deal?                  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  secondaryDeal SecondaryDeal?         @relation(fields: [secondaryDealId], references: [id], onDelete: Cascade)
  partnerAgent  User?                  @relation("PartnerCommissions", fields: [partnerAgentId], references: [id])
  statusHistory CommissionStatusLog[]

  @@index([status])
  @@index([partnerAgentId])
  @@map("commissions")
}

model CommissionStatusLog {
  id           String            @id @default(cuid())
  commissionId String            @map("commission_id")
  fromStatus   CommissionStatus? @map("from_status")
  toStatus     CommissionStatus  @map("to_status")
  changedBy    String?           @map("changed_by")
  note         String?           @db.Text
  createdAt    DateTime          @default(now()) @map("created_at")

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
  @@map("commission_status_logs")
}

// Журнал действий ИИ-агента по ведению сделок — что предложено/сделано и
// почему, чтобы каждое движение по CRM было прозрачным и проверяемым.
enum DealAgentActionType {
  STALLED_ALERT   // сделка зависла на этапе дольше нормы
  STAGE_SUGGESTED // предложен переход на следующий этап
  STAGE_APPLIED   // этап действительно передвинут агентом
}

model DealAgentAction {
  id         String              @id @default(cuid())
  dealId     String              @map("deal_id")
  actionType DealAgentActionType @map("action_type")
  fromStage  DealStage           @map("from_stage")
  toStage    DealStage?          @map("to_stage")
  reason     String              @db.Text
  createdAt  DateTime            @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([createdAt])
  @@map("deal_agent_actions")
}

model LeadForm {
  id               String   @id @default(cuid())
  title            String
  fields           Json     // [{ label, type, required, options }]
  distributionType String   @default("MANUAL") @map("distribution_type") // MANUAL, ROUND_ROBIN
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  brokers User[] @relation("FormBrokers") // Brokers enabled for this form

  @@map("lead_forms")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  isCompleted Boolean   @default(false) @map("is_completed")
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
