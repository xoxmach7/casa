// =========================================
// M06 CALCULATION ENGINE — run + immutable snapshot (spec v1.4).
// INV-0032 "NO PDF": движок принимает только параметры/ссылки на снапшоты,
// не документы. Snapshot иммутабелен: input_hash/output_hash по детерминированной
// канонизации (сорт-ключи JSON → sha256); полный CASA-CJ-1 §29 подключится позже.
// =========================================

/// M06 §21 Calculation run. Хранит ПОЛНЫЙ frozen execution context: прогон
/// должен быть воспроизводим по одной этой записи, без реконструкции «как оно
/// тогда, наверное, было». Каждое поле ниже соответствует строке §21.
model MortgageCalculationRun {
  id                    String   @id @default(cuid())
  caseId                String   @map("case_id")
  /// §21 tenant_id — M01 access scope. Отдельной сущности «арендатор» в модели
  /// CASA Pro нет: областью доступа M01 фактически является владелец кейса.
  /// Записываем ту область, которая РЕАЛЬНО проверялась при авторизации, и
  /// помечаем её вид — при появлении настоящего tenant отображение 1:1.
  tenantId              String   @map("tenant_id")
  tenantScopeKind       String   @default("CASE_OWNER") @map("tenant_scope_kind")
  actorId               String   @map("actor_id")
  engineVersion         String   @map("engine_version")
  decimalContextVersion String   @map("decimal_context_version")
  formulaRegistryVersion String  @map("formula_registry_version")
  // §21: client_profile_snapshot_id/hash обязателен и иммутабелен — это
  // единственный источник данных профиля для прогона.
  clientProfileSnapshotId   String @map("client_profile_snapshot_id")
  clientProfileSnapshotHash String @map("client_profile_snapshot_hash")
  /// §21 participant_scope: точные participant_id/role/included_in_analysis.
  /// Никакого неявного суммирования супруга/созаёмщика.
  participantScopeJson     Json   @map("participant_scope_json")
  /// §21 selected_upstream_refs: M02 batch + M03/M04 snapshot id/hash так, как
  /// их несёт M05. null допустим, пока модуль не реализован; фиктивные id — нет.
  selectedUpstreamRefsJson Json   @map("selected_upstream_refs_json")
  /// §21 requested_calculations: упорядоченные formula_id + версии. Если клиент
  /// их не передал, сервер берёт allowlist релиза 1.0, но СОХРАНЯЕТ выбранные.
  requestedCalculationsJson Json  @map("requested_calculations_json")
  /// §21 parameters: ставка/срок/периодичность + source/channel/actor.
  parametersJson        Json     @map("parameters_json")
  inputsJson            Json     @map("inputs_json")
  inputHash             String   @map("input_hash")
  /// §21 results / blockers: значение, статус, причина и ссылки на блокирующие входы.
  resultsJson           Json     @map("results_json")
  blockersJson          Json     @map("blockers_json")
  /// §21 calculated_at / actor + идемпотентность запроса.
  calculatedAt          DateTime @default(now()) @map("calculated_at")
  idempotencyKey        String   @map("idempotency_key")
  requestHash           String   @map("request_hash")
  status                String
  createdAt             DateTime @default(now()) @map("created_at")

  mortgageCase MortgageCase                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  snapshot     MortgageCalculationSnapshot?

  @@index([caseId, createdAt])
  @@map("mortgage_calculation_runs")
}

model MortgageCalculationSnapshot {
  id                    String   @id @default(cuid())
  caseId                String   @map("case_id")
  /// §22 Envelope: tenant_id обязателен (DC-M06-CAN-0059). Вид области — как в
  /// прогоне: отдельной сущности tenant в модели пока нет.
  tenantId              String   @map("tenant_id")
  tenantScopeKind       String   @default("CASE_OWNER") @map("tenant_scope_kind")
  runId                 String   @unique @map("run_id")
  schemaVersion         String   @map("schema_version")
  engineVersion         String   @map("engine_version")
  decimalContextVersion String   @map("decimal_context_version")
  formulaRegistryVersion String  @map("formula_registry_version")
  // §22 Hashes: три хэша + версия канонизации (CASA-CJ-1, §29).
  canonicalizationVersion   String @map("canonicalization_version")
  inputHash                 String @map("input_hash")
  outputHash                String @map("output_hash")
  replayHash                String @map("replay_hash")
  clientProfileSnapshotId   String @map("client_profile_snapshot_id")
  clientProfileSnapshotHash String @map("client_profile_snapshot_hash")
  /// Канонический replay payload (allowlist §29) — предъявляется как evidence
  /// и позволяет пересчитать replay_hash без обращения к движку.
  replayPayloadJson     Json     @map("replay_payload_json")
  resultsJson           Json     @map("results_json")
  status                String
  /// §22 Envelope: calculated_at фиксируется вместе со статусом и иммутабелен.
  calculatedAt          DateTime @default(now()) @map("calculated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  run          MortgageCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  mortgageCase MortgageCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("mortgage_calculation_snapshots")
}

// =========================================
// M05 CLIENT PROFILE — агрегат анкеты + под-ресурсы + иммутабельный снапшот.
// Каждое денежное поле несёт СТАТУС (DECLARED/VERIFIED/UNKNOWN/CONFLICT):
// UNKNOWN ≠ 0. available_now_total (вход для M06) считается из источников взноса.
// =========================================

enum MortgageProfileFieldStatus {
  DECLARED
  VERIFIED
  UNKNOWN
  CONFLICT
}

model MortgageClientProfile {
  id               String   @id @default(cuid())
  caseId           String   @unique @map("case_id")
  version          Int      @default(1)
  latestSnapshotId String?  @map("latest_snapshot_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  mortgageCase         MortgageCase                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  purchaseGoal         MortgagePurchaseGoal?
  employments          MortgageEmployment[]
  incomeSources        MortgageIncomeSource[]
  assets               MortgageAsset[]
  downPaymentSources   MortgageDownPaymentSource[]
  nonCreditCommitments MortgageNonCreditCommitment[]

  @@map("mortgage_client_profiles")
}

/// M05 purchase_goal — цель покупки. target_price_max отсюда является ЕДИНСТВЕННЫМ
/// источником цены для CALC-F-001 (source_field_ref = purchase_goal.target_price_max).
/// Отсутствие цели ≠ ноль: без неё расчёт блокируется, а не считается от нуля.
model MortgagePurchaseGoal {
  id             String                     @id @default(cuid())
  profileId      String                     @unique @map("profile_id")
  targetPriceMax Decimal?                   @map("target_price_max") @db.Decimal(20, 2)
  currency       String                     @default("KZT")
  status         MortgageProfileFieldStatus @default(UNKNOWN)
  propertyKind   String?                    @map("property_kind")
  regionCode     String?                    @map("region_code")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  profile MortgageClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("mortgage_purchase_goals")
}

model MortgageEmployment {
  id            String                     @id @default(cuid())
  profileId     String                     @map("profile_id")
  partyId       String?                    @map("party_id")
  employerName  String                     @map("employer_name")
  employmentKind String                    @map("employment_kind")
  status        MortgageProfileFieldStatus @default(DECLARED)
  createdAt     DateTime                   @default(now()) @map("created_at")

  profile MortgageClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("mortgage_employments")
}

model MortgageIncomeSource {
  id            String                     @id @default(cuid())
  profileId     String                     @map("profile_id")
  partyId       String?                    @map("party_id")
  kind          String
  monthlyAmount Decimal?                   @map("monthly_amount") @db.Decimal(20, 2)
  currency      String                     @default("KZT")
  status        MortgageProfileFieldStatus @default(DECLARED)
  createdAt     DateTime                   @default(now()) @map("created_at")

  profile MortgageClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("mortgage_income_sources")
}

model MortgageAsset {
  id        String                     @id @default(cuid())
  profileId String                     @map("profile_id")
  partyId   String?                    @map("party_id")
  kind      String
  value     Decimal?                   @db.Decimal(20, 2)
  currency  String                     @default("KZT")
  status    MortgageProfileFieldStatus @default(DECLARED)
  createdAt DateTime                   @default(now()) @map("created_at")

  profile MortgageClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("mortgage_assets")
}

model MortgageDownPaymentSource {
  id        String                     @id @default(cuid())
  profileId String                     @map("profile_id")
  partyId   String?                    @map("party_id")
  kind      String
  amount    Decimal?                   @db.Decimal(20, 2)
  currency  String                     @default("KZT")
  status    MortgageProfileFieldStatus @default(DECLARED)
  createdAt DateTime                   @default(now()) @map("created_at")

  profile MortgageClientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
