  "api": {
    "base_path": "/api/v1",
    "authentication": "tenant_scoped_session_or_bearer_token",
    "idempotency_required_for": [
      "POST /clients/{client_id}/consents",
      "POST /clients/{client_id}/documents",
      "POST /analyses",
      "POST /conclusions"
    ],
    "endpoints": [
      {"method": "POST", "path": "/clients", "purpose": "Создать клиента"},
      {"method": "GET", "path": "/clients", "purpose": "Поиск и список клиентов"},
      {"method": "GET", "path": "/clients/{client_id}", "purpose": "Получить карточку клиента"},
      {"method": "PATCH", "path": "/clients/{client_id}", "purpose": "Обновить анкету клиента"},
      {"method": "POST", "path": "/clients/{client_id}/consents", "purpose": "Создать запрос согласия"},
      {"method": "GET", "path": "/consents/{consent_id}", "purpose": "Получить публичную страницу согласия"},
      {"method": "POST", "path": "/consents/{consent_id}/otp/send", "purpose": "Отправить одноразовый код"},
      {"method": "POST", "path": "/consents/{consent_id}/confirm", "purpose": "Подтвердить или отклонить согласие"},
      {"method": "POST", "path": "/consents/{consent_id}/revoke", "purpose": "Отозвать согласие"},
      {"method": "POST", "path": "/clients/{client_id}/documents", "purpose": "Получить URL загрузки документа"},
      {"method": "POST", "path": "/documents/{document_id}/complete", "purpose": "Подтвердить завершение загрузки"},
      {"method": "GET", "path": "/documents/{document_id}/extraction", "purpose": "Получить распознанные поля и уверенность"},
      {"method": "PATCH", "path": "/documents/{document_id}/extraction", "purpose": "Исправить и подтвердить поля"},
      {"method": "POST", "path": "/clients/{client_id}/iin-checks", "purpose": "Запустить разрешенные проверки"},
      {"method": "GET", "path": "/clients/{client_id}/iin-checks/latest", "purpose": "Получить последние результаты"},
      {"method": "POST", "path": "/clients/{client_id}/snapshots", "purpose": "Создать подтвержденный снимок"},
      {"method": "POST", "path": "/analyses", "purpose": "Запустить анализ программ"},
      {"method": "GET", "path": "/analyses/{analysis_id}", "purpose": "Получить объяснимый результат"},
      {"method": "POST", "path": "/analyses/{analysis_id}/scenarios/generate", "purpose": "Сгенерировать сценарии"},
      {"method": "POST", "path": "/analyses/{analysis_id}/scenarios/preview", "purpose": "Пересчитать Что если"},
      {"method": "POST", "path": "/analyses/{analysis_id}/scenarios/{scenario_id}/select", "purpose": "Выбрать сценарий"},
      {"method": "GET", "path": "/analyses/{analysis_id}/property-matches", "purpose": "Получить подходящие квартиры"},
      {"method": "POST", "path": "/clients/{client_id}/selections", "purpose": "Сохранить подборку квартир"},
      {"method": "POST", "path": "/conclusions", "purpose": "Зафиксировать и создать заключение"},
      {"method": "GET", "path": "/conclusions/{public_token}", "purpose": "Открыть клиентское заключение"},
      {"method": "GET", "path": "/conclusions/{conclusion_id}/pdf", "purpose": "Скачать PDF"},
      {"method": "GET", "path": "/mortgage-programs", "purpose": "Получить опубликованные версии программ"},
      {"method": "POST", "path": "/mortgage-programs/{program_id}/versions", "purpose": "Создать версию программы"},
      {"method": "POST", "path": "/mortgage-programs/{program_id}/versions/{version_id}/publish", "purpose": "Опубликовать проверенную версию"}
    ],
