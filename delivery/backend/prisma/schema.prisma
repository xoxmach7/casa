generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  password            String
  role                UserRole
  firstName           String              @map("first_name")
  lastName            String              @map("last_name")
  phone               String?
  city                String? // New: broker city
  balance             Decimal             @default(0) @db.Decimal(15, 2) // New: current balance
  casaFee             Decimal             @default(0) @map("casa_fee") @db.Decimal(15, 2) // New: total Casa fees
  certificationStatus CertificationStatus @default(IN_PROGRESS) @map("certification_status") // New
  curatorId           String?             @map("curator_id") // New: assigned curator
  curatorName         String?             @map("curator_name") // Curator display name
  curatorPhone        String?             @map("curator_phone") // Curator phone
  curatorEmail        String?             @map("curator_email") // Curator email  
  curatorWhatsApp     String?             @map("curator_whatsapp") // Curator WhatsApp
  isActive            Boolean             @default(true) @map("is_active")
  status              UserStatus          @default(ACTIVE) // ACTIVE у всех существующих; застройщик регится как PENDING до одобрения админом
  // Профиль компании-застройщика (заполняется только для роли DEVELOPER)
  companyName         String?             @map("company_name")
  bin                 String?             // БИН/ИИН компании
  companyPhone        String?             @map("company_phone")
  companyLogo         String?             @map("company_logo")   // URL логотипа
  companyWebsite      String?             @map("company_website")
  companyDescription  String?             @map("company_description")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  // Relations
  bookings       Booking[]
  clients        Client[]
  projects       Project[]        @relation("DeveloperProjects")
  courseProgress CourseProgress[]
  notifications  Notification[]
  tasks          Task[]
  deals          Deal[]
  curator        User?            @relation("CuratorBrokers", fields: [curatorId], references: [id])
  brokers        User[]           @relation("CuratorBrokers")
  payments       Payment[]
  forms          LeadForm[]       @relation("FormBrokers")
  // CASA CRM Relations
  sellers        Seller[]         @relation("BrokerSellers")
  selections     Selection[]
  crmProperties  CrmProperty[]    @relation("BrokerCrmProperties")
  buyers         Buyer[]          @relation("BrokerBuyers")
  customFunnels  CustomFunnel[]
  customFields   CustomField[]
  events         Event[]
  subscriptions  Subscription[]
  mortgageApplications MortgageApplication[] @relation("BrokerApplications")
  fixations            Fixation[]
  testAttempts         TestAttempt[]
  auditLogs            AuditLog[]
  configVersions       ConfigVersion[]
  fileAssets           FileAsset[]
  reviewedValuations   ValuationVersion[]
  propertyInterests    ClientPropertyInterest[]
  coordinatingDeals    SecondaryDeal[]
  ownedDealRisks       DealRisk[]
  authoredMortgageRules  MortgageRuleVersion[] @relation("MortgageRuleAuthor")
  approvedMortgageRules  MortgageRuleVersion[] @relation("MortgageRuleApprover")
  favorites              Favorite[]
  mortgageCasesOwned     MortgageCase[]              @relation("MortgageCaseOwner")
  mortgageIdempotency    MortgageIdempotencyRecord[] @relation("MortgageIdempotencyActor")
  mortgageAuditEvents    MortgageAuditEvent[]        @relation("MortgageAuditActor")
  mortgageDocuments      MortgageDocument[]          @relation("MortgageDocumentUploader")
  mortgageDocRevisions   MortgageDocumentRevision[]  @relation("MortgageDocumentRevisionCreator")
  mortgageFieldReviews   MortgageFieldReview[]        @relation("MortgageFieldReviewer")
  mortgageSnapshots      MortgageVerifiedSnapshot[]   @relation("MortgageSnapshotConfirmer")

  // === Контур вторички ===
  ownerSellerProfile     Seller?                      @relation("OwnerSellerProfile")
  agentFixations         SecondaryFixation[]          @relation("AgentFixations")
  agencyFixations        SecondaryFixation[]          @relation("AgencyFixations")
  partnerCommissions     Commission[]                 @relation("PartnerCommissions")
  agencySubscriptions    AgencySubscription[]         @relation("AgencySubscriptions")
  declaredListingExits   ListingExit[]                @relation("ListingExitDeclarant")

  @@map("users")
}


model Client {
  id             String       @id @default(cuid())
  iin            String       @unique
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  middleName     String?      @map("middle_name") @db.VarChar
  phone          String
  email          String?
  city           String?      // город клиента
  clientType     ClientType   @default(BUYER) @map("client_type") // New: BUYER/SELLER
  budget         Decimal?     @db.Decimal(15, 2) // New: client budget
  status         ClientStatus @default(NEW)
  monthlyIncome  Decimal?     @map("monthly_income") @db.Decimal(15, 2)
  initialPayment Decimal?     @map("initial_payment") @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  brokerId       String       @map("broker_id")

  // Relations
  bookings             Booking[]
  documents            ClientDocument[]
  broker               User                  @relation(fields: [brokerId], references: [id])
  mortgageCalculations MortgageCalculation[]
  deals                Deal[]
  events               Event[]
  mortgageApplications MortgageApplication[]
  selections           Selection[]
  scorings             ClientScoring[]
  fixations            Fixation[]
  propertyLinks        ClientPropertyLink[]
  consents             ClientConsent[]
  mortgageCases        MortgageCase[]
  mortgageCaseParties  MortgageCaseParty[]

  @@index([brokerId])
  @@index([status])
  @@index([clientType])
  @@map("clients")
}

// ... (at the end of file)

// =========================================
// CALENDAR & EVENTS (Phase 8)
// =========================================

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  type        EventType
  location    String?
  
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId    String?  @map("client_id")
  client      Client?  @relation(fields: [clientId], references: [id]) 
  
  propertyId  String?  @map("property_id")
  property    CrmProperty? @relation(fields: [propertyId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([startDate])
  @@map("events")
}

enum EventType {
  SHOWING
  MEETING
  CALL
  OTHER
}

// =========================================
// SUBSCRIPTIONS (Подписки)
// =========================================

model Subscription {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  plan        SubscriptionPlan   @default(FREE)
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime           @default(now()) @map("starts_at")
  expiresAt   DateTime?          @map("expires_at")
  amount      Decimal?           @db.Decimal(15, 2)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE       // Бесплатный (ограниченный)
  BASIC      // Базовый (CRM + заявки)
  PRO        // Про (CRM + заявки + обучение)
  ENTERPRISE // Корпоративный (агентства)
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// =========================================
// MORTGAGE APPLICATIONS (Заявки в банки)
// =========================================

model MortgageApplication {
  id              String                    @id @default(cuid())
  clientId        String                    @map("client_id")
  bankName        String                    @map("bank_name")
  programName     String?                   @map("program_name")
  loanAmount      Decimal                   @map("loan_amount") @db.Decimal(15, 2)
  termMonths      Int                       @map("term_months")
  interestRate    Decimal?                  @map("interest_rate") @db.Decimal(5, 2)
  status          MortgageApplicationStatus @default(DRAFT)
  responseDate    DateTime?                 @map("response_date")
  responseNotes   String?                   @map("response_notes") @db.Text
  brokerId        String                    @map("broker_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  client          Client                    @relation(fields: [clientId], references: [id])
  broker          User                      @relation("BrokerApplications", fields: [brokerId], references: [id])

  @@index([clientId])
  @@index([brokerId])
  @@index([status])
  @@map("mortgage_applications")
}

enum MortgageApplicationStatus {
  DRAFT      // Черновик
  SUBMITTED  // Подана
  REVIEWING  // На рассмотрении
  APPROVED   // Одобрена
  REJECTED   // Отклонена
  CANCELLED  // Отменена
}

model Project {
  id               String         @id @default(cuid())
  name             String
  description      String?
  city             String
  district         String? // New: район
  address          String
  lat              Float?  // Широта для карты
  lng              Float?  // Долгота для карты
  class            String? // эконом, комфорт, бизнес
  buildingStatus   BuildingStatus @default(UNDER_CONSTRUCTION) @map("building_status") // New
  isPublished      Boolean        @default(false) @map("is_published") // Виден на публичном сайте (casa40)
  publishedAt      DateTime?      @map("published_at")
  deliveryDate     DateTime?      @map("delivery_date")
  developerName    String?        @map("developer_name") // New: застройщик
  developerPhone   String?        @map("developer_phone") // New
  crmUrl           String?        @map("crm_url") // Ссылка на CRM застройщика
  bonus            String? // New: бонусы и акции
  promotions       String?        @map("promotions") // Специальные акции и условия
  mortgagePrograms String[]       @default([]) @map("mortgage_programs") // Доступные программы ипотеки
  images           String[]
  videoUrl         String?        @map("video_url") // New
  features         String[]       @default([]) @map("features") // Особенности ЖК (список)
  nearby           String[]       @default([]) @map("nearby") // Что интересного рядом (список)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  developerId      String         @map("developer_id")

  // Relations
  apartments Apartment[]
  buildings  Building[]
  sellers   Seller[]
  developer  User        @relation("DeveloperProjects", fields: [developerId], references: [id])
  fixations  Fixation[]

  @@index([developerId])
  @@index([city])
  @@index([district])
  @@index([buildingStatus])
  @@index([isPublished])
  @@map("projects")
}

// Обратная связь от пользователей CRM (кнопка «Оставить обратную связь» в сайдбаре).
model Feedback {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  userName  String?  @map("user_name")
  role      String?
  message   String
  contact   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([resolved])
  @@map("feedback")
}

model Building {
  id         String      @id @default(cuid())
  name       String
  projectId  String      @map("project_id")
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apartments Apartment[]
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([projectId])
  @@map("buildings")
}

model Apartment {
  id          String          @id @default(cuid())
  number      String
  floor       Int
  rooms       Int
  area        Decimal         @db.Decimal(10, 2)
  price       Decimal         @db.Decimal(15, 2)
  status      ApartmentStatus @default(AVAILABLE)
  layoutImage String?         @map("layout_image")
  images      String[]        @default([]) // New: дополнительные фото квартиры
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  projectId   String          @map("project_id")
  buildingId  String?         @map("building_id")
  entrance    Int?

  // Relations
  sellers              Seller[]
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  building             Building?             @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  bookings             Booking[]
  mortgageCalculations MortgageCalculation[]
  selectionApartments  SelectionApartment[]
  fixations            Fixation[]
  favorites            Favorite[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([status])
  @@index([rooms])
  @@index([buildingId])
  @@map("apartments")
}

model Booking {
  id          String        @id @default(cuid())
  status      BookingStatus @default(PENDING)
  expiresAt   DateTime      @map("expires_at")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  clientId    String        @map("client_id")
  apartmentId String        @map("apartment_id")
  brokerId    String        @map("broker_id")
  apartment   Apartment     @relation(fields: [apartmentId], references: [id])
  broker      User          @relation(fields: [brokerId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([apartmentId])
  @@index([brokerId])
  @@index([status])
  @@map("bookings")
}

model MortgageCalculation {
  id             String     @id @default(cuid())
  propertyPrice  Decimal    @map("property_price") @db.Decimal(15, 2)
  initialPayment Decimal    @map("initial_payment") @db.Decimal(15, 2)
  loanAmount     Decimal    @map("loan_amount") @db.Decimal(15, 2)
  interestRate   Decimal    @map("interest_rate") @db.Decimal(5, 2)
  termMonths     Int        @map("term_months")
  monthlyPayment Decimal    @map("monthly_payment") @db.Decimal(15, 2)
  totalPayment   Decimal    @map("total_payment") @db.Decimal(15, 2)
  overpayment    Decimal    @db.Decimal(15, 2)
  bankName       String?    @map("bank_name")
  programName    String?    @map("program_name")
  apartmentId    String?    @map("apartment_id")
  apartmentInfo  String?    @map("apartment_info")
  createdAt      DateTime   @default(now()) @map("created_at")
  clientId       String     @map("client_id")
  client         Client     @relation(fields: [clientId], references: [id])
  apartment      Apartment? @relation(fields: [apartmentId], references: [id])

  @@index([clientId])
  @@index([apartmentId])
  @@map("mortgage_calculations")
}

// Скоринг клиента для ипотеки — на основе вручную введённых КИ (кредитная
// история) и ПО (пенсионные отчисления), пока без интеграции с ЕНПФ/бюро.
model ClientScoring {
  id                  String              @id @default(cuid())
  clientId            String              @map("client_id")
  creditHistoryStatus CreditHistoryStatus @map("credit_history_status")
  avgMonthlyPension   Decimal             @map("avg_monthly_pension") @db.Decimal(15, 2)
  existingMonthlyDebt Decimal             @default(0) @map("existing_monthly_debt") @db.Decimal(15, 2)
  downPayment         Decimal             @default(0) @map("down_payment") @db.Decimal(15, 2)
  scoreValue          Int                 @map("score_value")
  approvalLikelihood  ApprovalLikelihood  @map("approval_likelihood")
  maxLoanAmount       Decimal             @map("max_loan_amount") @db.Decimal(15, 2)
  maxMonthlyPayment   Decimal             @map("max_monthly_payment") @db.Decimal(15, 2)
  maxPropertyPrice    Decimal             @default(0) @map("max_property_price") @db.Decimal(15, 2)
  advice              String[]
  createdAt           DateTime            @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_scorings")
}

// "Фиксация" — заявка брокера застройщику на закрепление клиента за собой
// для конкретного ЖК/квартиры, чтобы защитить происхождение клиента и
// избежать двойных комиссий (ТЗ раздел 8).
enum FixationPaymentMethod {
  FULL         // 100% оплата
  MORTGAGE     // Ипотека
  INSTALLMENT  // Рассрочка
}

enum FixationStatus {
  DRAFT               // Черновик, ещё не отправлена
  SENT                // Отправлена застройщику
  DUPLICATE_CHECK      // Застройщик/CASA проверяет на дубль клиента
  CONFIRMED           // Клиент закреплён за брокером
  REJECTED_DUPLICATE  // Отказ: клиент уже существует у застройщика
  REJECTED_OTHER      // Отказ по другой причине
  EXPIRED             // Истёк срок действия закрепления
  BOOKING_REQUESTED   // Запрошена бронь квартиры
  BOOKED              // Бронь подтверждена
  DEAL                // Сделка подтверждена
  CANCELLED           // Отменена уполномоченной ролью
}

model Fixation {
  id              String         @id @default(cuid())
  clientId        String         @map("client_id")
  projectId       String         @map("project_id")
  apartmentId     String?        @map("apartment_id")
  brokerId        String         @map("broker_id")
  status          FixationStatus @default(DRAFT)
  paymentMethod   FixationPaymentMethod? @map("payment_method")
  dealAmount      Decimal?       @map("deal_amount") @db.Decimal(15, 2)
  rejectionReason String?        @map("rejection_reason") @db.Text
  sentAt          DateTime?      @map("sent_at")
  expiresAt       DateTime?      @map("expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  client        Client               @relation(fields: [clientId], references: [id])
  project       Project              @relation(fields: [projectId], references: [id])
  apartment     Apartment?           @relation(fields: [apartmentId], references: [id])
  broker        User                 @relation(fields: [brokerId], references: [id])
  statusHistory FixationStatusLog[]

  @@index([clientId])
  @@index([projectId])
  @@index([brokerId])
  @@index([status])
  @@map("fixations")
}

model FixationStatusLog {
  id         String          @id @default(cuid())
  fixationId String          @map("fixation_id")
  fromStatus FixationStatus? @map("from_status")
  toStatus   FixationStatus  @map("to_status")
  changedBy  String?         @map("changed_by")
  note       String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at")

  fixation Fixation @relation(fields: [fixationId], references: [id], onDelete: Cascade)

  @@index([fixationId])
  @@map("fixation_status_logs")
}

enum CreditHistoryStatus {
  GOOD        // Хорошая, без просрочек
  HAS_DELAYS  // Были просрочки в прошлом
  BAD         // Плохая / активная просрочка
}

enum ApprovalLikelihood {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA // Не хватает данных (нет ни дохода, ни ПО) для реальной оценки
}

model ClientDocument {
  id         String   @id @default(cuid())
  name       String
  type       String
  fileUrl    String   @map("file_url")
  fileSize   Int      @map("file_size")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_documents")
}

// Подборка — набор квартир из новостроек, которую брокер собирает под
// запросы конкретного клиента (не для вторичного рынка).
enum SelectionStatus {
  DRAFT           // Собирается брокером, ссылка ещё не отправлена
  SHARED          // Ссылка отправлена клиенту
  VIEWED          // Клиент открыл ссылку хотя бы раз
  CLIENT_SELECTED // Клиент отметил понравившийся вариант
  CLOSED          // Подборка закрыта (сделка/отказ)
}

model Selection {
  id         String          @id @default(cuid())
  name       String?
  status     SelectionStatus @default(DRAFT)
  // Непредсказуемый токен для публичной ссылки клиенту — доступ без логина,
  // отдаёт только client-safe проекцию (без цены/финансов/внутренних заметок).
  shareToken String          @unique @default(cuid())
  viewedAt   DateTime?       @map("viewed_at")
  selectedApartmentId String? @map("selected_apartment_id")
  // Вторичка (CASA Developer Handoff v2.0, раздел 7.2 Product Master —
  // "Подборка объединяет вторичку и новостройки"). Отдельное поле, а не
  // переиспользование selectedApartmentId, т.к. это разные сущности/таблицы.
  selectedCrmPropertyId String? @map("selected_crm_property_id")
  brokerId   String          @map("broker_id")
  clientId   String          @map("client_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  broker     User                 @relation(fields: [brokerId], references: [id])
  client     Client               @relation(fields: [clientId], references: [id])
  apartments SelectionApartment[]
  crmProperties SelectionCrmProperty[]

  @@index([brokerId])
  @@index([clientId])
  @@map("selections")
}

// Вторичка-аналог SelectionApartment — отдельная join-таблица, а не
// полиморфный apartmentId, чтобы не трогать существующую NOT NULL колонку
// с живыми данными (см. gap-audit, раздел про Selection).
model SelectionCrmProperty {
  id            String   @id @default(cuid())
  selectionId   String   @map("selection_id")
  crmPropertyId String   @map("crm_property_id")
  addedAt       DateTime @default(now()) @map("added_at")

  selection   Selection   @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  crmProperty CrmProperty @relation(fields: [crmPropertyId], references: [id], onDelete: Cascade)

  @@unique([selectionId, crmPropertyId])
  @@index([selectionId])
  @@index([crmPropertyId])
  @@map("selection_crm_properties")
}

model SelectionApartment {
  id          String   @id @default(cuid())
  selectionId String   @map("selection_id")
  apartmentId String   @map("apartment_id")
  addedAt     DateTime @default(now()) @map("added_at")

  selection Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([selectionId, apartmentId])
  @@index([selectionId])
  @@index([apartmentId])
  @@map("selection_apartments")
}

// Личное «быстрое избранное» брокера: закладка на квартиру без привязки к
// клиенту (в отличие от Selection, которая всегда принадлежит клиенту).
model Favorite {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  apartmentId String   @map("apartment_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([userId, apartmentId])
  @@index([userId])
  @@map("favorites")
}

enum UserRole {
  ADMIN
  BROKER
  DEVELOPER
  REALTOR
  AGENCY
  // Роли контура вторички из CASA Developer Handoff v2.0. До их появления
  // модули оценки и Deal Room были зажаты под ADMIN, то есть работать в них
  // было некому. COORDINATOR ведёт сделку и подтверждает оценку; ANALYST
  // собирает аналоги и считает, но решения не принимает.
  COORDINATOR
  ANALYST
  // Собственник квартиры на вторичке. Единственная роль, которая может
  // создавать объекты вторички: агенты приходят только с покупателем.
  OWNER
}

// Статус аккаунта. Нужен для само­регистрации застройщика: он создаётся как
// PENDING и не может войти, пока админ не одобрит (ACTIVE) или не отклонит
// (REJECTED). Все ранее созданные пользователи — ACTIVE (дефолт).
