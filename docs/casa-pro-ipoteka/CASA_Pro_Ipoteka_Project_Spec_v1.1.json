  "calculation_engine": {
    "money_rounding": "KZT_integer_for_display_decimal_for_internal_calculation",
    "formulas": [
      {
        "id": "annuity_payment",
        "expression": "P * r * (1 + r)^n / ((1 + r)^n - 1)",
        "variables": {
          "P": "loan_principal",
          "r": "monthly_nominal_rate",
          "n": "term_months"
        },
        "warning": "Использовать параметры конкретной версии программы; комиссии и страхование считать отдельно."
      },
      {
        "id": "preliminary_kdn",
        "expression": "(existing_monthly_obligations + proposed_mortgage_payment) / accepted_confirmed_income * 100",
        "warning": "Состав обязательств, дохода и предельное значение определяются правилами конкретного банка и программы."
      },
      {
        "id": "down_payment_gap",
        "expression": "max(0, required_down_payment - available_down_payment)"
      },
      {
        "id": "loan_amount",
        "expression": "property_price - down_payment"
      },
      {
        "id": "estimated_income_from_opv",
        "expression": "opv_amount / configured_opv_ratio",
        "warning": "Только предварительная база. Принимаемый банком доход подтверждается документами и правилами программы."
      }
    ],
    "rule_result": {
      "status_enum": ["pass", "fail", "unknown", "manual"],
      "required_output": [
        "rule_id",
        "status",
        "actual_value",
        "required_value",
        "delta",
        "human_reason",
        "remediation_actions",
        "source_reference",
        "program_version_id"
      ]
    },
    "reproducibility": {
      "required": true,
      "store": [
        "client_snapshot_id",
        "program_version_ids",
        "engine_version",
        "input_hash",
        "calculation_trace",
        "calculated_at"
      ]
    }
  },
  "scenario_engine": {
    "goal": "Найти минимальное проверяемое изменение, которое открывает программу или снижает риск и ежемесячную нагрузку.",
    "types": [
      {
        "id": "increase_down_payment",
        "inputs": ["additional_down_payment"],
        "outputs": ["new_loan_amount", "new_payment", "new_kdn", "opened_programs", "missing_amount"]
      },
      {
        "id": "close_obligation",
        "inputs": ["obligation_id", "payoff_amount"],
        "outputs": ["new_existing_payment", "new_kdn", "opened_programs", "cash_required"]
      },
      {
        "id": "refinance_high_rate_debt",
        "inputs": [
          "obligation_id",
          "verified_refinancing_rate",
          "verified_refinancing_gesv",
          "new_term_months",
          "fees",
          "insurance",
          "offer_valid_until"
        ],
        "outputs": [
          "old_payment",
          "new_payment",
          "monthly_saving",
          "total_cost_difference",
          "new_kdn",
          "opened_programs",
          "break_even_month"
        ],
        "guardrails": [
          "No rate is assumed without a user-entered or integrated verified offer.",
          "Show total cost and fees, not only lower monthly payment.",
          "Mark as preliminary until lender confirms the refinancing offer."
        ]
      },
      {
        "id": "partial_early_repayment",
        "inputs": [
          "obligation_id",
          "prepayment_amount",
          "recalculation_mode",
          "new_schedule_source"
        ],
        "allowed_recalculation_modes": ["reduce_payment", "reduce_term"],
        "default_recalculation_mode": "reduce_payment",
        "outputs": [
          "old_balance",
          "new_balance",
          "old_payment",
          "estimated_new_payment",
          "monthly_saving",
          "new_kdn",
          "opened_programs"
        ],
        "guardrails": [
          "The recommendation must explicitly select payment reduction when the goal is lower debt load.",
          "Final value requires a new lender schedule or verified recalculation rule.",
          "Do not mutate the original obligation."
        ]
      },
      {
        "id": "increase_confirmed_income",
        "inputs": [
          "income_amount",
          "income_type",
          "confirmation_method",
          "program_acceptance_status"
        ],
        "outputs": ["accepted_income", "new_kdn", "opened_programs", "required_documents"],
        "guardrails": [
          "Count only income accepted by the selected program.",
          "Display required evidence and verification status.",
          "Never recommend artificial or false income."
        ]
      },
      {
        "id": "lower_property_budget",
        "inputs": ["new_property_price"],
        "outputs": ["new_loan_amount", "new_payment", "new_kdn", "opened_programs", "matching_properties"]
      },
      {
        "id": "add_co_borrower",
        "inputs": ["co_borrower_snapshot_id"],
        "outputs": ["combined_accepted_income", "combined_obligations", "new_kdn", "opened_programs", "required_documents"]
      },
      {
        "id": "wait_for_history",
        "inputs": ["target_date", "reason"],
        "outputs": ["expected_rule_changes", "reminder_date", "programs_to_recalculate"]
      }
    ],
    "combination_policy": {
      "max_changes_per_scenario": 3,
      "default_show_count": 5,
      "prohibited": [
        "fabricated_income",
        "hidden_debt",
        "unverified_bank_exception",
        "scenario_that_worsens_total_cost_without_warning"
      ]
    },
    "ranking": {
      "factors": [
        {"id": "eligibility_gain", "weight": 0.35},
        {"id": "cash_required", "weight": 0.2},
        {"id": "monthly_payment_reduction", "weight": 0.15},
        {"id": "total_cost", "weight": 0.1},
        {"id": "time_to_complete", "weight": 0.1},
        {"id": "document_complexity", "weight": 0.05},
        {"id": "rule_confidence", "weight": 0.05}
      ],
      "explanation_required": true
    }
  },
  "program_knowledge_base": {
    "no_hardcoded_rules_in_ui": true,
    "verification_status_enum": [
      "officially_verified",
      "bank_confirmed",
      "observed_requires_confirmation",
      "stale_requires_review",
