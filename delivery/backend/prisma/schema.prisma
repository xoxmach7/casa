  CANCELLED
  EXPIRED
  COMPLETED
}

enum BuildingStatus {
  UNDER_CONSTRUCTION
  COMPLETED
  READY_TO_MOVE
}

enum CertificationStatus {
  IN_PROGRESS
  CERTIFIED
  INACTIVE
}

