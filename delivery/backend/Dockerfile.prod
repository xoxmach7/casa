# Продакшен-образ бэкенда: собирается TypeScript, запускается скомпилированный
# JS. Раньше здесь стоял `npx tsx src/index.ts` — «чтобы ошибка сборки не
# уронила деплой». Теперь typecheck и сборка выполняются в CI на каждый пуш
# (.github/workflows/ci.yml), поэтому до образа сломанный TypeScript не
# доезжает, и тащить в прод dev-раннер больше незачем.

# ---- сборка ----
FROM node:22-slim AS builder

WORKDIR /app

# OpenSSL нужен Prisma для генерации клиента
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci

COPY . .
RUN npx prisma generate
RUN npm run build

# ---- рантайм ----
FROM node:22-slim AS runtime

WORKDIR /app

# curl оставлен для ручной диагностики контейнера (healthcheck Railway ходит
# снаружи, но проверить /health изнутри бывает нужно)
RUN apt-get update -y && apt-get install -y openssl curl && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production

# Схема и миграции копируются ДО npm ci: во-первых, `prisma generate` ниже
# требует schema.prisma, во-вторых, миграции нужны в рантайме — контейнер
# накатывает их сам при старте (см. CMD).
COPY package*.json ./
COPY prisma ./prisma/

# Только прод-зависимости: tsx, vitest и прочий dev-инструментарий в рантайм
# не едут. CLI `prisma` — намеренное исключение, он переехал в dependencies:
# без него контейнер не сможет выполнить `migrate deploy` на старте. Вместе с
# ним приезжает typescript (~23 МБ) — это его optional peer, npm ставит такие
# автоматически; выключать это `--omit=optional` не стоит, под раздачу попадут
# и нужные пакеты.
RUN npm ci --omit=dev && npx prisma generate && npm cache clean --force

COPY --from=builder /app/dist ./dist

# Пути к загрузкам считаются от __dirname и совпадают для src/ и dist/:
# и /app/src/routes/../../uploads, и /app/dist/routes/../../uploads — это
# /app/uploads, куда Railway монтирует том.
#
# Сиды тоже скомпилированы: `node dist/prisma/seed.js` вместо `npm run db:seed`.

EXPOSE 3001

# Миграции накатываются автоматически при старте, до того как поднимется HTTP.
# Раньше их накатывали руками, и это уже один раз выстрелило: код с ролью
# COORDINATOR уехал в прод, а enum в базе про неё не знал.
#
# Падение миграции роняет контейнер намеренно. Сервер на несовместимой схеме
# отвечает 500 на случайных запросах и пишет мусор в базу — это хуже, чем
# честно не подняться и остаться на предыдущем деплое.
#
# Параллельный запуск нескольких реплик безопасен: `migrate deploy` берёт
# advisory lock в самой базе, вторая реплика дожидается первую.
CMD ["sh", "-c", "npx prisma migrate deploy && exec node dist/index.js"]
